min delta lambda i[ind]=
	mean delta lambda i[ind]-3*sd delta lambda i[ind]
	~	percentage
	~		|

mixed income per capita d[inc cat]=
	mixed income total*People 1/sum(pop d[inc cat!])
	~	Euro
	~		|

mixed income total=
	GWB*Mixed to labour income ratio
	~	Euro
	~	GWB*Mixed_to_labour_income_ratio
	|

Mixed to labour income ratio=
	(Initial mixed income)/initial GWB
	~	Dmnl
	~	0.75 is roughly the initial average propensity to consume, such that the consumption \
		out of mixed income is equal to the mixed income row in the input output
		
		(Initial mixed income/0.75)/initial GWB
