[inc low e m,paid w],[inc low e m,unpaid w],[inc low e m,leisure],
[inc mid e f,paid w],[inc mid e f,unpaid w],[inc mid e f,leisure],
[inc mid e m,paid w],[inc mid e m,unpaid w],[inc mid e m,leisure],
[inc hig e f,paid w],[inc hig e f,unpaid w],[inc hig e f,leisure],
[inc hig e m,paid w],[inc hig e m,unpaid w],[inc hig e m,leisure],
