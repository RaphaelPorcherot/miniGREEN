CO2 nrg i[liquid,ind]=
	coeff E C to CO2 nrg i[liquid,ind]*E C nrg i[liquid,ind] ~~|
CO2 nrg i[gas,ind]=
	coeff E C to CO2 nrg i[gas,ind]*E C nrg i[gas,ind] ~~|
CO2 nrg i[biomass,ind]=
	coeff E C to CO2 nrg i[biomass,ind]*E C nrg i[biomass,ind] ~~|
