		rates 2130 i
	|

Act WTR=
	0
	~	Dmnl
	~	0 = INACTIVE
		1 = active
	|

adapt hh ct=
	IF THEN ELSE(Act gradual adapt CT hh = 1, carbon tax rate/S carbon tax max, 1 )
	~	Dmnl
	~		|

adaptation sensitivity=
	0.025
	~	Dmnl/Year
	~		|

adult population gs[gender,skill]=
	Skills 1524 gs[gender,skill]+Skills 2544 gs[gender,skill]
	+Skills 4564 gs[gender,skill]+"Skills 65+ gs"[gender,skill]
	~	People
	~		|

adult population s[skill]=
	sum(adult population gs[gender!,skill])
	~	People
	~		|

assets:
	deposits,
	bonds,
	equities
	~	Euro
	~		|

associated co2emissions i nrg v[ind,nrg,techn]=
	associated nrg dem i v nrg[ind,nrg,techn]*coef Ed to C nrg i[nrg,ind]*coeff E C to CO2 nrg i\
		[nrg,ind]
	~	TJ
	~		|

associated energydem iiv[ind,toind,techn]=
	(ME ii[ind,toind]*z T real iiv[ind,toind,techn]/1e+06)*(1/tech capital trend delay i\
		[ind])/Euro constant 1
	~	TJ/Euro constant
	~		|

associated nrg dem from imp i v[toind,techn]=
	sum(z T real iiv[ind!,toind,techn]*share imp Z ii[ind!,toind])*Ecoef Zimp i[toind]/goods euro constant 1e6
	~	TJ
	~		|

associated nrg dem i v nrg[toind,nrg,techn]=
	(sum(associated energydem iiv[ind!,toind,techn])*Euro constant 1+associated nrg dem from imp i v\
		[toind,techn])*Share source Ed Z nrg i
	[nrg,toind]
	~	TJ
	~		|

av daily work hours delay gs[gender,skill]= DELAY FIXED (
	av daily work hours gs[gender,skill], Year 1 , init av daily work hours gs[gender,skill\
		])
	~	Hours
	~		|

av daily work hours gs[gender,skill]=
	((sum(hours i[ind!]*L gis[gender,ind!,skill]))/(sum(L gis[gender,ind!,skill])))
	/(working weeks per year*5)
	~	Hours
	~		|

av infl cumulative d[inc cat]=
	sum(beta delay dp[inc cat,coicop!]*infl cumulative p[coicop!])
