	~	observed trend in skill endowment when entering working age
		*IF_THEN_ELSE(Time<S_begining,
		                1,
		                \
		1+min(S_end-S_begining,Time-S_begining)*(S_working_hours/(S_end-S_begining)\
		)
		                )
	|

u=
	max(0.01,U tot/sum(labour supply gs[gender!,skill!]+JG L gs[gender!,skill!]))*100
	~	percentage
	~	percentage
	|

u delay gs[gender,skill]=
	DELAY FIXED(u gs[gender,skill], Year 1 , u initial gs[gender,skill] )
	~	percentage
	~		|

u g[gender]=
	max(0.01,(sum(labour supply gs[gender,skill!])-sum(L gis[gender,ind!,skill!])-sum(JG L gs\
		[gender,skill!]))/sum(labour supply gs[gender,skill!]+JG L gs[gender,skill!]))
	~	percentage
	~		|

u gs[gender,skill]=
	max(0.01,(labour supply gs[gender,skill]-sum(L gis[gender,ind!,skill])-JG L gs[gender\
		,skill])/(labour supply gs[gender,skill]+JG L gs[gender,skill]))
	~	Dmnl
	~	unemployment rate by industry by skill by gender
	|

u initial gs[female,skill]=
	0.124,	0.092,	0.069 ~~|
u initial gs[male,skill]=
	0.093,	0.068,	0.044
	~	percentage
	~	GET DIRECT CONSTANTS('economy.xlsx', 'labour', 'C62' )
	|

u s[skill]=
	max(0.01,(sum(labour supply gs[gender!,skill])-sum(L is[ind!,skill])-sum(JG L gs[gender\
		!,skill]))/(sum(labour supply gs[gender!,skill])+sum(JG L gs[gender!,skill])))
	~	Dmnl
	~		|

U SRF i[ind]=
	Subs RES fossil SRF i[ind] / y nom i[ind]
	~	Dmnl
	~	unit costs in case of reduction of fossil subsidies
	|

U tot=
	sum(labour supply gs[gender!,skill!])-sum(L gis[gender!,ind!,skill!])-JG L tot
	~	People
	~		|

ub coverage ratio=
	0.462369
	~	percentage
	~	coverage ratio: fraction of unemployed receiving unemployment benefits:
		GET_DIRECT_CONSTANTS('economy.xlsx', 'government', 'C8' )
	|

ub wage ratio=
	S1 ub wage ratio*IF THEN ELSE(Time<S Time Policy start,
	                1,
	                1+min(S Time end-S Time Policy start,Time-S Time Policy start)*(S ub ratio\
		/(S Time end-S Time Policy start))
	                )
	~	percentage
	~	unemployment benefit's fraction of wages
	|

uc i[ind]=
	y real i[ind]/y FC i[ind]
	~	Dmnl
	~	rate of capacity utilisation
	|

uc normal=
	0.8
	~	Dmnl
	~	aproximate stable historical mean for US, see Setterfield & Avritzer, 2020 \
		(Metroeconomica)
		GET DIRECT CONSTANTS( 'economy.xlsx', 'investments', 'normalcaputi')
	|

UCC delay i[ind]= DELAY FIXED (
	UCC i[ind], Year 1 , 0)
	~	Dmnl
	~		|

UCC delay2 i[ind]= DELAY FIXED (
	UCC i[ind], (Year 1+Year 1) , 0)
	~	Dmnl
	~		|

UCC i[ind]=
	carbon cost tot i[ind]/y nom i[ind]
	~	Dmnl
	~		|

UFC delay i[ind]= DELAY FIXED (
	UFC i[ind], Year 1 , UFC initial i[ind])
	~	Euro/Goods
	~		|

UFC i[ind]=
	UIC i[ind] + ULC i[ind] + U SRF i[ind]*euro goods 1
	~	Euro/Goods
	~	unit full costs
	|

UFC T delay iv[ind,techn]= DELAY FIXED (
	UFC T iv[ind,techn], Year 1 , initial UFC T iv[ind,techn])
