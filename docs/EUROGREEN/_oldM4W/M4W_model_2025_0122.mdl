	~	Euro
	~	GET DIRECT CONSTANTS('economy.xlsx', 'inputoutput', 'C12')
	|

Z real tot=
	sum(Zs real i[ind!])
	~	Euro constant
	~		|

Z T demand iv[toind,techn]=
	sum((1+share imp Z ii[ind!,toind])*z T nom iiv[ind!,toind,techn])
	~	Euro
	~		|

z T nom iiv[ind,toind,techn]=
	p i delay[ind]*z T real iiv[ind,toind,techn]
	~	Euro
	~		|

z T real iiv[ind,toind,techn]=
	a T iiv[ind,toind,techn]*y real delay i[toind]
	~	Goods
	~		|

Zd real i[ind]=
	sum(Z real ii[ind,toind!])
	~	Euro constant
	~		|

Zs real i[toind]=
	sum( Z real ii[ind!,toind] )
	~	Euro constant
	~	sum by row
	|

********************************************************
	.male,ind,skill
********************************************************~
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 40
	~	Year
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Year
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	Year [0,?]
	~	The time step for the simulation.
	|

