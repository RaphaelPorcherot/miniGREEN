mortality rate cg[cohorts,female]=
	0.00026943,	0.000161,	0.0004338,	0.0026594,	0.0392796 ~~|
mortality rate cg[cohorts,male]=
	0.000322585,	0.0004381,	0.0008434,	0.0048954,	0.0467657
	~	Dmnl
