	~		|

"check\_share\_sources i"[ind]=
	sum(Share source Ed Z nrg i[nrg!,ind])
	~	Dmnl
	~		|

CO2=
	CO2 Nace tot+ 
	CO2 hh tot
	~	kton
	~	in Ttons
	|

CO2 cost ETS i[ind]=
	(CO2 ETS i[ind]*1000 - Free ETS i[ind](Time/Year 1)/(1000)* Kton 1)*p ETS/ Kton 1
	~	Euro
	~		|

CO2 ETS i[ind]=
	CO2 i[ind] * selection ETS i[ind]
	~	kton
	~		|

CO2 fd hh nrg[nrg]=
	coeff E C to CO2 hh nrg[nrg]*E C hh nrg[nrg]
	~	kton
	~		|

CO2 for CT i[ind]=
	CO2 i[ind]* (1 - selection ETS i[ind])
	~	kton
	~		|

CO2 hh tot=
	sum(CO2 fd hh nrg[nrg!])
	~	kton
	~		|

CO2 i[ind]=
	sum(CO2 nrg i[nrg!,ind])* kton tj 1
	~	kton
	~		|

CO2 Nace tot=
	sum(CO2 i[ind!])
	~	kton
	~		|

CO2 nrg[nrg]=
