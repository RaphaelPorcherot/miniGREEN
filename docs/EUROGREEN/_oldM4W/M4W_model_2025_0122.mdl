	~	Dmnl
	~	COICOP NACE bridge matrix: GET DIRECT CONSTANTS('economy.xlsx', 'consumption', 'U3')
		
		Previous comment
		GET_DIRECT_CONSTANTS('economy.xlsx', 'consumption', 'B3')
	|

c dom nom=
	sum(c dom nom i[ind!])
	~	Euro
	~		|

c dom nom i[ind]=
	(1-share imp hh i[ind])*c nom i[ind]
	~	Euro
	~	nominal consumption demand for domestic industries
	|

c dom real i[ind]=
	c dom nom i[ind]/p i[ind]
	~	Euro constant
	~		|

c dp[inc cat,coicop]=
	c tot d[inc cat]*beta dp[inc cat,coicop]
	~	Euro
	~	individual consumption expenditure by income groups and consumption \
		categories
	|

c imp nom i[ind]=
	share imp hh i[ind] * c nom i[ind]
	~	Euro
	~	nominal import of households
	|

c imp real i[ind]=
	c imp nom i[ind]/p i[ind]
	~	Euro constant
	~		|

c inc d[inc cat]=
	min(mpc inc d[inc cat]*exp yd d[inc cat], yd d[inc cat])
	~	Euro
	~	consumption expenditure from income
	|

c nom i[ind]=
	c real i[ind]*p i[ind]
	~	Euro
	~	nominal demand of consumption goods within nation in NACE classification
	|

c p[coicop]=
	sum(c dp[inc cat!,coicop]*pop d[inc cat!])/People 1
	~	Euro
	~	final demand nominal coicop from total population
	|

c real i[ind]=
	IF THEN ELSE(Time=10*Year 1,
	             c real i delay[ind]*(1+c19 shock cons),
	             IF THEN ELSE(Time=11* Year 1,
	                          c real i delay[ind]*(1+c19 shock cons),IF THEN ELSE(Time=12\
		*Year 1,c real i delay[ind]*(1+c19 shock cons),
	                          sum(bridge ip[ind,coicop!]*c real p[coicop!])
	                         )
	             ))
	~	Goods
	~	real demand of consumption goods within nation in NACE classification
	|

c real i delay[ind]= DELAY FIXED (
	c real i[ind], Year 1 , Goods 0)
	~	Goods
	~		|

c real p[coicop]=
	c p[coicop]/(euro goods 1+infl cumulative p[coicop])
	~	Goods
	~	real demand of consumption goods within nation in COICOP classification
	|

c tot d[inc cat]=
	(c inc d[inc cat]+c w d[inc cat])*
	IF THEN ELSE(Time<S Time Policy start,
	                1,
	                1+(Time-S Time Policy start)*(Act cons red*S mpc/(S Time end-S Time Policy start\
		))
	                )
	~	Euro
	~	previous formula was increasing consumption (changed in 31/10/22)!
		
		(c inc d[inc cat]+c w d[inc cat])*
		IF THEN ELSE(Time<S Time Policy start,
		                1,
		                1-min(S Time end-S Time Policy start,Time-S Time Policy start)*(Act \
		cons red*S mpc/(S Time end-S Time Policy start))
		                )
		
		
		
		individual total consumption expenditure
		(c_inc_d[inc_cat]+c_w_d[inc_cat])*
		IF_THEN_ELSE(Time<S_Time_Policy_start,
		                1,
		                \
		1+min(S_end-S_Time_Policy_start,Time-S_Time_Policy_start)*(S_mpc/(S_end-S_T\
		ime_Policy_start))
		                )
		
		S_Time_end
	|

