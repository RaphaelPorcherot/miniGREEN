	~	Euro
	~		|

check Ed Z=
	sum(Ed Z nrg[nrg!]) - sum(Ed Z tot i[ind!])
	~	TJ
	~		|

check EdZ1=
	sum(Ed Z tot i[ind!]) + sum(Ed Z tot public i[ind!]) - Ed Z tot
	~	TJ
	~		|

check hh share sources=
	sum(share sources Ed fd hh nrg[nrg!])
	~	Dmnl
	~		|

check L=
