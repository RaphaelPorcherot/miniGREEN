	~	People
	~		|

People Euro 0=
	0
	~	People*Euro
	~		|

tj 1=
	1
	~	TJ
	~		|

associated GHG cost[ind,techn]=
	sum(associated co2emissions i nrg v[ind,nrg!,techn])*coef CO2 to GHG i[ind]*1000*carbon tax rate\
		*Act carbon tax/tj 1
	~	Euro
	~		|

euro 1=
	1
	~	Euro
	~		|

Kton 1=
	1
	~	kton
	~		|

euro goods 1=
	1
	~	Euro/Goods
	~		|

Euro 0=
	0
	~	Euro
	~		|

goods euro constant 1e6=
	1e+06
	~	Goods/Euro constant
	~		|

c19 shock exp=
	IF THEN ELSE(Time=10*Year 1,c19 exp 2020,IF THEN ELSE(Time=11*Year 1,c19 exp 2021,0)\
		)
	~	Dmnl
	~		|

Dmnl Year=
	1
	~	Dmnl/Year
	~		|

