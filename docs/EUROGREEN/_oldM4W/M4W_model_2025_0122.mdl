	|

vat rate[ind]=
	base VAT rate*IF THEN ELSE(Time<S Time Policy start,
	                1,
	                1+min(S Time end-S Time Policy start,Time-S Time Policy start)*(S vat rate\
		/(S Time end-S Time Policy start))
	                )
	~	percentage
	~	value added tax rates. Will keep the 11% (effective economy wide rate = \
		https://data.worldbank.org/indicator/GC.TAX.GSRV.VA.ZS?locations=IT )
		GET_DIRECT_CONSTANTS('economy.xlsx', 'government', 'vat_rates' )
	|

vat rev=
	sum(vat i[ind!])
	~	Euro
