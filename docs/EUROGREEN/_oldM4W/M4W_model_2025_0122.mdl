in wage gis[gender,ind,skill]=
	IF THEN ELSE(Time=S Time Policy start,(min wage average change gis[gender,ind,skill]\
		*(Coefficient wage dispersion[gender
	,ind,skill]*wage delay gis[gender,ind,skill]))+wage gis[gender,ind,skill]*(omega lambda\
		[skill]*g lamba i[ind]+omega price*inflation
	+ omega employment[skill]*g L gis[gender,ind,skill])
	,wage gis[gender,ind,skill]*(omega lambda[skill]*g lamba i[ind]+omega price*inflation\
		+ omega employment[skill]*g L gis[gender,ind,skill
	]))
	
	+IF THEN ELSE(Time <S Time Policy start,0* People 1 ,Act WTR wage*delta wage WTR[gender\
		,ind,skill])
	+IF THEN ELSE(Time=S Time Policy start,Act maximum wage*(max wage average change gis\
		[gender,ind,skill]*(Coefficient wage dispersion
	[gender,ind,skill]*wage delay gis[gender,ind,skill])),0)
	~	Euro
	~	previous formula 10/05/23
		IF THEN ELSE(wage gis[gender,ind,skill]<50*euro 1,
		wage gis[gender,ind,skill]*(omega lambda*g lamba i[ind]+omega price*inflation+ omega \
		employment*g e gs[gender,skill])
		                           +IF THEN ELSE(average wage changes gis[gender,ind,skill] \
		< -1.96* euro 1,0* euro 1, 
		0.5*min wage average change gis[gender,ind,skill]*(Coefficient wage \
		dispersion[gender,ind,skill]*wage delay gis[gender,ind,skill])),
		min(0* euro 1,wage gis[gender,ind,skill]*(omega lambda*g lamba i[ind]+ omega \
		price*inflation+omega employment[skill]*g e gs[gender,skill])+ IF THEN \
		ELSE(average wage changes gis[gender,ind,skill] < -1.96* euro 1,0* euro 1, \
		0.5*min wage average change gis[gender,ind,skill]*(Coefficient wage \
		dispersion[gender,ind,skill]*wage delay gis[gender,ind,skill])
		)))+IF THEN ELSE(Time <S Time Policy start,0* People 1 ,Act WTR wage*delta wage \
		WTR[gender,ind,skill])
		
		%%%%%%%%%%%%%%%
		wage_gis[gender,ind,skill]*(
		omega_lambda*g_lamba_i[ind]+
		omega_price*inflation+
		omega_employment*(1/(1-e_gs[gender,skill]))
		                           )
	|

b param beta distribution i[ind] :EXCEPT: [agri]=
	a param beta distribution i[ind]*exp damage normalized i[ind]/(1-exp damage normalized i\
		[ind]) ~~|
b param beta distribution i[agri]=
	a param beta distribution i[agri]*exp damage normalized i[agri]/(1-exp damage normalized i\
		[agri])
	~	Dmnl
	~	b parameter of the climate damage Beta distribution
	|

exp damage normalized i[ind] :EXCEPT:    [agri]=
	(exp damage i[ind] - 0)/(229/230 - 0) ~~|
exp damage normalized i[agri]=
	(exp damage i[agri] - 0)/(1841/1825 - 0)
	~	percentage [0,1]
	~	Expected climate damage on sectoral production (w.r.t. a counterfactual scenario \
		where temperature is always at the 'optimal' level)
		Normalized to lie in the [0, 1] interval
	|

damage beta distribution i[ind] :EXCEPT:      [agri]=
	RANDOM BETA(0, 1, a param beta distribution i[ind], b param beta distribution i[ind]\
		, 0, 1, seed) ~~|
damage beta distribution i[agri]=
	RANDOM BETA(0, 1, a param beta distribution i[agri], b param beta distribution i[agri\
		], 0, 1, seed)
	~	Dmnl [0,1]
	~	Climate damage on production (random draw from a Beta(a,b) distribution)
	|

damage multiplier i[ind] :EXCEPT:                    [agri]=
	1 - damage beta distribution i[ind] ~~|
damage multiplier i[agri]=
	1 - damage beta distribution i[agri]
	~	Dmnl [0,1]
	~	Sectoral climate damage multiplier
	|

a param beta distribution i[ind] :EXCEPT:     [agri]=
	10*ABS(400/23 - Temperature) ~~|
a param beta distribution i[agri]=
	10*ABS(1540/73 - Temperature)
	~	Dmnl
	~	a parameter of the climate damage Beta distribution
	|

g L gis[gender,ind,skill]=
	(L gis[gender,ind,skill]-L gis Delay[gender,ind,skill])/L gis Delay[gender,ind,skill\
		]
	~	
	~		|

exp damage i[ind] :EXCEPT: [agri]=
	max(0.3 + 0.08*Temperature - 0.0023*Temperature^2, 0) ~~|
exp damage i[agri]=
	max(-2.24 + 0.308*Temperature - 0.0073*Temperature^2, 0)
	~	percentage [0,?]
	~	Expected climate damage on sectoral production (w.r.t. a counterfactual scenario \
		where temperature is always at the 'optimal' level)
		Max exp_damage agriculture: 1841/1825 when T = 1540/73 = 21.09
		Max exp_damage other sectors: 229/230 when T =  400/23 = 17.39
	|

L gis Delay[gender,ind,skill]=
	DELAY FIXED(L gis[gender,ind,skill],1 ,L gis initial[gender,ind,skill] )
	~	
	~		|

L gis initial[gender,ind,skill]= INITIAL(
	L gis[gender,ind,skill])
	~	
	~		|

ordered component Theil L[gender,ind,skill]=
	VECTOR SORT ORDER(component Theil L[gender,ind,skill],1)
	~	
	~		|

group wage share gis[gender,ind,skill]=
	GWB gis[gender,ind,skill]/GWB
	~	
	~		|

Theil T wage=
	sum(component Theil T[gender!,ind!,skill!])
	~	
	~		|

L gis share[gender,ind,skill]=
	L gis[gender,ind,skill]/sum(L gis[gender!,ind!,skill!])
	~	
	~		|

