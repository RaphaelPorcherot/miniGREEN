{UTF-8}
tot Z=
	sum( Z real ii[ind!,ind!])
	~	
	~		|

polluting ind:
	agri,mining,manufacturing,petroleum,electricity
	~	
	~		|

lambda T iv[ind,T1]=
	lambda diffusion i[ind]*goods 1/People 1/Hours 1 ~~|
lambda T iv[ind,T2]=
	lambda delay i[ind]*(1+delta lambda T2 i[ind]) ~~|
lambda T iv[ind,T3]=
	lambda delay i[ind]*(1+delta lambda T3 i[ind]) ~~|
lambda T iv[ind,T4]=
	lambda delay i[ind]*(1+delta lambda T4 i[ind])
	~	Goods/(People*Hours)
	~		|

delta lambda T4 i[ind]=
	RANDOM NORMAL( min delta lambda i[ind] + sd delta lambda i[ind]  , max delta lambda i\
		[ind] + sd delta lambda i[ind
	]  , max(0,mean delta lambda i[ind]) + sd delta lambda i[ind] , sd delta lambda i[ind\
		] , seed )
	~	Dmnl
	~	change in labour productivity for T4
		
		scalling lambda*
	|

pop share d[inc cat]=
	pop d[inc cat]/sum(pop d[inc cat!])
	~	Dmnl
	~		|

a ii[ind,toind]=
	IF THEN ELSE (Time=initial year,initial a ii[ind,toind],
	max(
	    (IF THEN ELSE(T i[ind]=UFC T iv[ind,T1], a diffusion ii[ind,toind] , 
	                  IF THEN ELSE( T i[ind]=UFC T iv[ind,T2],a delay ii[ind,toind]*(1+delta a T2 ii\
		[ind,toind]), 
	                                IF THEN ELSE( T i[ind]=UFC T iv[ind,T3] , a delay ii\
		[ind,toind]*(1+delta a T3 ii[ind,toind
	]) ,
	                                a delay ii[ind,toind]*(1+delta a T4 ii[ind,toind]) )\
		)))
	   *
	   (1+delta damage multiplier i[ind]),
	0))
	~	Dmnl
	~	isso estava somando no denominador na penultima linha (16/2/23)
		+IF THEN ELSE(Time>10*Year 1,delta damage multiplier i[ind],0)
		%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
		Final da formula 4*delta damage multiplier i[ind],0)),
		%%%%%%%%%%%%%%%%
		IF_THEN_ELSE (Time=0,initial_a_ii[ind,toind],
		max(
		    (IF_THEN_ELSE(T_i[ind]=UFC_T_iv[ind,T1], a_diffusion_ii[ind,toind] , 
		                  IF_THEN_ELSE( \
		T_i[ind]=UFC_T_iv[ind,T2],a_delay_ii[ind,toind]*(1+delta_a_T2_ii[ind,toind]\
		), 
		                                IF_THEN_ELSE( T_i[ind]=UFC_T_iv[ind,T3] , \
		a_delay_ii[ind,toind]*(1+delta_a_T3_ii[ind,toind]) ,
		                                a_delay_ii[ind,toind]*(1+delta_a_T4_ii[ind,toind]) \
		))))
		   /
		   (1+delta_damage_multiplier_i[ind]),
		0))
	|

yd order[inc cat]=
	VECTOR SORT ORDER(yd d[inc cat], 1 )
	~	Dmnl
	~		|

ygross share[inc cat]=
	(ygross d[inc cat]*pop d[inc cat])/(sum(ygross d[inc cat!]*pop d[inc cat!]))
	~	Dmnl
	~		|

a T iiv[ind,toind,T1]=
	a diffusion ii[ind,toind] ~~|
a T iiv[ind,toind,T2]=
	a delay ii[ind,toind]*(delta a T2 ii[ind,toind]) ~~|
a T iiv[ind,toind,T3]=
	a delay ii[ind,toind]*(delta a T3 ii[ind,toind]) ~~|
a T iiv[ind,toind,T4]=
	a delay ii[ind,toind]*(delta a T4 ii[ind,toind])
	~	Dmnl
	~		|

aaa[ind, case 1]=
	1
	~	
	~		|

yd d ordered[gini order]=
	VECTOR REORDER(yd d[inc cat], yd order[inc cat] )
	~	
	~		|

delta lambda T3 i[ind]=
	RANDOM NORMAL( min delta lambda i[ind] - sd delta lambda i[ind] , max delta lambda i\
		[ind] - sd delta lambda i[ind]
	, max(0,mean delta lambda i[ind] - sd delta lambda i[ind]) , sd delta lambda i[ind] \
		, seed )
	~	Dmnl
	~	change of labour productivity for T3
		scalling lambda*
	|

T i[ind]=
	IF THEN ELSE( cases Tech i[ind,case 1]>0, UFC T iv[ind,T1], 
	IF THEN ELSE( cases Tech i[ind,case 2]>0, min(UFC T iv[ind,T1], UFC T iv[ind,T2]), 
	IF THEN ELSE( cases Tech i[ind,case 3]>0, min(UFC T iv[ind,T1], UFC T iv[ind,T3]), 
	IF THEN ELSE( cases Tech i[ind,case 4]>0, min(UFC T iv[ind,T1], min(UFC T iv[ind,T2]\
		,UFC T iv[ind,T3])),                IF THEN ELSE( cases Tech i[ind,case 5]>0, min(UFC T iv\
		[ind,T1], UFC T iv[ind,T4]), 
	IF THEN ELSE( cases Tech i[ind,case 6]>0, min(UFC T iv[ind,T1],  min(UFC T iv[ind,T2\
		], UFC T iv[ind,T4])),
	IF THEN ELSE( cases Tech i[ind,case 7]>0, min( UFC T iv[ind,T1], min(UFC T iv[ind,T3\
		], UFC T iv[ind,T4])),
	min(min(UFC T iv[ind,T1],UFC T iv[ind,T2]) ,min(UFC T iv[ind,T3],UFC T iv[ind,T4])
	)
	)
	) 
	)
	)
	)
	))
	~	Euro/Goods
	~	choice of adopted technology
	|

delta a T2 ii[ind,toind]=
	RANDOM NORMAL(min delta a ii[ind,toind]+sd delta a ii[ind,toind], max delta a ii[ind\
		,toind]+ sd delta a ii[ind,toind
	], 
	0.5*mean delta a ii[ind,toind] + sd delta a ii[ind,toind], sd delta a ii[ind,toind] \
		, seed )
	~	Dmnl
	~	*initial_a_ii[ind,toind]
		changes in technical coefficients for T2
		scalling tech*
	|

lambda no diffusion i[ind]= INTEG (
	IF THEN ELSE(T i[ind]=UFC T iv[ind,T1], lambda diffusion i[ind]*goods 1/ People 1/Hours 1\
		/ Year 1 , 
	IF THEN ELSE( T i[ind]=UFC T iv[ind,T2] , delta lambda T2 i[ind]*goods 1/ People 1/Hours 1\
		/ Year 1 , 
	IF THEN ELSE( T i[ind]=UFC T iv[ind,T3] , delta lambda T3 i[ind] *goods 1/ People 1/\
		Hours 1/ Year 1,
	delta lambda T4 i[ind]*goods 1/ People 1/Hours 1/ Year 1 ))),
		initial lambda i[ind])
	~	Goods/People/Hours
	~		|

yd share[inc cat]=
	(yd d[inc cat]*pop d[inc cat])/sum(yd d[inc cat!]*pop d[inc cat!])
	~	Dmnl
	~		|

delta a T4 ii[ind,toind]=
	RANDOM NORMAL(min delta a ii[ind,toind] - sd delta a ii[ind,toind], max delta a ii[ind\
		,toind] - sd delta a ii
	[ind,
	toind], 
	0.5*mean delta a ii[ind,toind]-sd delta a ii[ind,toind] , sd delta a ii[ind,toind] ,\
		 seed )
	~	Dmnl
	~	*initial_a_ii[ind,toind]
		changes in technical coefficients for T4
		scalling tech*
	|

lambda i[ind]=
	IF THEN ELSE(Time=0*Year 1,initial lambda i[ind],
	max(IF THEN ELSE(T i[ind]=UFC T iv[ind,T1], lambda diffusion i[ind]*Euro constant 1/\
		(Hours 1*People 1), 
	IF THEN ELSE( T i[ind]=UFC T iv[ind,T2] ,lambda delay i[ind]*(1+delta lambda T2 i[ind\
		]), 
	IF THEN ELSE( T i[ind]=UFC T iv[ind,T3] , lambda delay i[ind]*(1+delta lambda T3 i[ind\
		]),
	lambda delay i[ind]*(1+delta lambda T4 i[ind])))),0*goods 1/ People 1/ Hours 1))
	/
	IF THEN ELSE(Time<12*Year 1,1,1+0*(1-delta damage multiplier i[ind]))
	~	Goods/People/Hours
	~		|

delta lambda T2 i[ind]=
	RANDOM NORMAL( min delta lambda i[ind] + sd delta lambda i[ind], max delta lambda i[\
		ind] + sd delta lambda i
	[ind],
	max(0,mean delta lambda i[ind]) + sd delta lambda i[ind] , sd delta lambda i[ind] , \
		seed )
	~	Dmnl
	~	change in labour productivity for T2
		scalling lambda*
	|

delta a T3 ii[ind,toind]=
	RANDOM NORMAL(min delta a ii[ind,toind] - sd delta a ii[ind,toind], max delta a ii[ind\
		,toind] - sd delta a ii
	[ind,toind],0.5*mean delta a ii[ind,toind] - sd delta a ii[ind,toind], sd delta a ii\
		[ind,toind] , seed )
	~	Dmnl
	~	*initial_a_ii[ind,toind]
		changes in technical coefficients for T3
		scalling tech*
	|

c w d[inc cat]=
	max(mpc inc d[inc cat]*exp yd d[inc cat]-yd d[inc cat],Euro 0)
	~	Euro
	~	consumption expenditure from wealth
	|

cases Tech i[ind, case 1]=
	(1-draw T2 i[ind])*(1-draw T3 i[ind])*(1-draw T4 i[ind]) ~~|
cases Tech i[ind,case 2]=
	draw T2 i[ind]*(1-draw T3 i[ind])*(1-draw T4 i[ind]) ~~|
cases Tech i[ind,case 3]=
	draw T3 i[ind]*(1-draw T2 i[ind])*(1-draw T4 i[ind]) ~~|
cases Tech i[ind,case 4]=
	draw T2 i[ind]*draw T3 i[ind]*(1-draw T4 i[ind]) ~~|
cases Tech i[ind,case 5]=
	draw T4 i[ind] ~~|
cases Tech i[ind,case 6]=
	draw T2 i[ind]*(1-draw T3 i[ind])*draw T4 i[ind] ~~|
cases Tech i[ind,case 7]=
	(1-draw T2 i[ind])*draw T3 i[ind]*draw T4 i[ind] ~~|
cases Tech i[ind,case 8]=
	draw T2 i[ind]*draw T3 i[ind]*draw T4 i[ind]
	~	
	~		|

cases T:
	case 1,
	case 2,
	case 3,
	case 4,
	case 5,
	case 6,
	case 7,
	case 8
	~	
	~		|

VA i[ind]=
	(y nom i[ind] - z demand nom i[ind])* p init i[ind]
	~	Euro
	~	value addded: (y nom i[ind]-z demand nom i[ind])* p initial i[ind]
	|

base VAT rate=
	0.1
	~	
	~	0.11 original
	|

temp RCP scenario=
	3
	~	Dmnl
	~	0: no damage
		1: RPC2.6
		2: RPC4.5
		3: RPC6.0
		4: RPC8.5
	|

Act econ damage=
	1
	~	
	~		|

delta damage multiplier i[ind]=
	IF THEN ELSE (Time<(14*Year 1),
	damage multiplier i[ind]-damage multiplier delay i[ind],
	
	Act econ damage*damage*
	min(damage multiplier i[ind]-damage multiplier delay i[ind],0)*max(adaptation,0))
	~	Dmnl
	~		|

spread b(
	[(0,0)-(10,10)],(0,0.026),(1,0.02),(3,0),(14,0),(40,0.018))
	~	
	~		|

w eff 2(
	[(0,0)-(10,10)],(0,1),(14,1),(40,0.9))
	~	
	~		|

w eff 3(
	[(0,0)-(10,10)],(0,1),(14,1),(40,0.8))
	~	
	~		|

coeff BLUE i[ind]=
	Initial coeff BLUE i[ind]*w eff
	~	
	~		|

P=
	IF THEN ELSE(Time<S Time Policy start, P1 , Precipitation )
	~	
	~	The statistics of total annual precipitation (P) are used in the period \
		1951-2022. It is assumed that precipitation follows a normal distribution. \
		From this distribution, synthetic precipitation series are generated, with \
		which evapotranspiration is estimated from a linear relationship.
	|

Act w eff=
	0
	~	
	~	reduction of water intensity for all sectors,
		0 = no eff
		1 = low (5% from 2024 to 2050)
		2 = med (10% from 2024 to 2050)
		3 = high (20% from 2024 to 2050)
	|

coeff adj BLUE SW i[ind] :EXCEPT:    [agri]=
	coeff BLUE i[ind]*ratio SW i[ind] ~~|
coeff adj BLUE SW i[agri]=
	coeff BLUE i[agri]*ratio SW i[agri]
	~	
	~	The initial proportion for Italy: η gw groundwater and η sw surface water.
		The distinction is between irrigated agriculture and zootechnics. 4.3% of \
		the total water in the agriculture sector is zootechnics in Toscana; \
		therefore, the part of the WIOD coefficient that is adjusted is 95.3% A \
		percentage for zootechnics in Italy is needed.
	|

w eff 1(
	[(0,0)-(10,10)],(0,1),(14,1),(40,0.95))
	~	
	~		|

w eff=
	IF THEN ELSE(Act w eff = 0 , 1,
	             IF THEN ELSE(Act w eff = 1, w eff 1(Time) , 
	                          IF THEN ELSE(Act w eff = 2, w eff 2(Time) , 
	              w eff 3(Time))
	                          )
	             )
	~	
	~		|

coeff adj BLUE GW i[ind] :EXCEPT:   [agri]=
	coeff BLUE i[ind]*ratio GW i[ind] ~~|
coeff adj BLUE GW i[agri]=
	coeff BLUE i[agri]*ratio GW i[agri]
	~	
	~		|

PET=
	const PET + coeff P *P + coeff T*Temperature + error PET
	~	
	~	(const PET + coeff P *P + error PET)/1000
	|

T max RCP85(
	[(0,0)-(10,10)],
	(0,13.9),
	(1,14.4),
	(2,14.4),
