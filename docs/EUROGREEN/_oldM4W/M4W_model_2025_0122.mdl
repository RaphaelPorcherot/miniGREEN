Act en eff=
	0
	~	Dmnl
	~	0 = inactive
		1 = active
	|

Act focalized benefit=
	0
	~	Dmnl
	~		|

Act gradual adapt CT hh=
	0
	~	Dmnl
	~	gradual adaptation to carbon tax by consumers
		0 = inactive
		1 = active
	|

Act labour tax redistribution=
	0
	~	Dmnl
	~	0: inactive
		1: active
	|

Act phase out=
	0
	~	Dmnl
	~	0 = inactive
		1 = active
	|

Act progressive Inc Tax=
	0
	~	Dmnl
	~		|

Act RES public=
	0
	~	Dmnl
