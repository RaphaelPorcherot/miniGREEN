	~	
	~		|

max average wage changes gis[gender,ind,skill]=
	difference wage max wage gis[gender,ind,skill]/(Coefficient wage dispersion[gender,ind\
		,skill]*wage delay gis[gender,ind,skill])*euro 1
	~	
	~		|

difference wage max wage gis[gender,ind,skill]=
	Maximum Wage Value-wage delay gis[gender,ind,skill]
	~	
	~		|

tot gov exp=
	transfers exp + 
	I gov + 
	wages gov + 
	total gov c nom + 
	gov interest + 
	adaptation exp + 
	RES public exp + 
	wage WTR gov total cost + 
	pnrr gov spend
	~	Euro
	~		|

pnrr gov spend=
	1.226e+11*Act PNRR*Time pnrr
	~	
	~	Il Governo intende richiedere il massimo delle risorse RRF, pari a 191,5 \
		miliardi di euro, divise in 68,9 miliardi di euro in sovvenzioni e 122,6 \
		miliardi di euro in prestiti.
	|

Act PNRR=
	1
	~	Dmnl
	~	Activates investments of PNRR and Fondo Complementare
		0 = INACTIVE
		1 = active
	|

Time 1st import price shock=
	11
	~	
	~		|

import price shock=
	0.13
	~	
	~		|

Markup shock value=
	0.15
	~	
	~		|

c tot real d[inc cat]=
	c tot d[inc cat]/(1+av infl cumulative d[inc cat])
	~	
	~		|

av infl cum d delay[inc cat]=
	DELAY FIXED(av infl cumulative d[inc cat],1,0)
	~	
	~		|

inflation rate inccat[inc cat]=
	((1+av infl cumulative d[inc cat])/(1+av infl cum d delay[inc cat]))-1
	~	
	~		|

inflation weights i[ind]=
	c nom i[ind]/sum(c nom i[ind!])
	~	
	~		|

Act Wage Indexation=
	0
	~	Dmnl
	~	0 = INACTIVE
		1 = active
	|

Multiplier Wage Indexation=
	0.5
	~	
	~		|

Time pnrr=
	IF THEN ELSE(Time<12,0,IF THEN ELSE(Time=12, 0.12, IF THEN ELSE(Time>12,IF THEN ELSE\
		(Time<17,0.22,0),0)))
	~	
	~	PNRR spending starts in 2022. amount spent was 12% of total
	|

inv pnrr[ind]=
	pnrr[ind]*Time pnrr
	~	
	~		|

pnrr m[m1,ind]=
	0,
	0,
	8.97198e+08,
	0,
	0,
	0,
	4.06431e+10,
	0,
	0,
	0,
	2.69159e+09,
	0,
	0,
	0,
	0,
	0,
	0,
	0,
	0 ~~|
pnrr m[m2,ind]=
	0,
	0,
	3.26773e+10,
	0,
	0,
	0,
