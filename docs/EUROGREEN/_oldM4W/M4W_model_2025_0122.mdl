[inc low p f,unpaid w], [inc low p f,leisure],
[inc low p m,unpaid w],[inc low p m,leisure],
[inc mid p f,unpaid w],[inc mid p f,leisure],
[inc mid p m,unpaid w],[inc mid p m,leisure],
[inc hig p f,unpaid w],[inc hig p f,leisure],
[inc hig p m,unpaid w],[inc hig p m,leisure]=
	0*Hours 1/Year 1 ~~|
in time use dt[inc low e f,paid w]=
	(av daily work hours gs[female,low]-av daily work hours delay gs[female,low])/Year 1\
		 ~~|
in time use dt[inc low e m,paid w]=
	(av daily work hours gs[male,low]-av daily work hours delay gs[male,low])/Year 1 ~~|
in time use dt[inc mid e f,paid w]=
	(av daily work hours gs[female,mid]-av daily work hours delay gs[female,mid])/Year 1\
		 ~~|
in time use dt[inc mid e m,paid w]=
	(av daily work hours gs[male,mid]-av daily work hours delay gs[male,mid])/Year 1 ~~|
in time use dt[inc hig e f,paid w]=
	(av daily work hours gs[female,hig]-av daily work hours delay gs[female,hig])/Year 1\
		 ~~|
in time use dt[inc hig e m,paid w]=
	(av daily work hours gs[male,hig]-av daily work hours delay gs[male,hig])/Year 1 ~~|
in time use dt[inc low e f,unpaid w]=
	(sens uw g[female]*(av daily work hours gs[female,low]-av daily work hours delay gs[\
		female,low]))/Year 1 ~~|
in time use dt[inc low e m,unpaid w]=
	(sens uw g[male]*(av daily work hours gs[male,low]-av daily work hours delay gs[male\
		,low]))/Year 1 ~~|
in time use dt[inc mid e f,unpaid w]=
	(sens uw g[female]*(av daily work hours gs[female,mid]-av daily work hours delay gs[\
		female,mid]))/Year 1 ~~|
in time use dt[inc mid e m,unpaid w]=
	(sens uw g[male]*(av daily work hours gs[male,mid]-av daily work hours delay gs[male\
		,mid]))/Year 1 ~~|
in time use dt[inc hig e f,unpaid w]=
	(sens uw g[female]*(av daily work hours gs[female,hig]-av daily work hours delay gs[\
		female,hig]))/Year 1 ~~|
in time use dt[inc hig e m,unpaid w]=
	(sens uw g[male]*(av daily work hours gs[male,hig]-av daily work hours delay gs[male\
		,hig]))/Year 1 ~~|
in time use dt[inc low e f,leisure]=
	(-(1+sens uw g[female])*(av daily work hours gs[female,low]-av daily work hours delay gs\
		[female,low]))/Year 1 ~~|
in time use dt[inc low e m,leisure]=
	(-(1+sens uw g[male])*(av daily work hours gs[male,low]-av daily work hours delay gs\
		[male,low]))/Year 1 ~~|
in time use dt[inc mid e f,leisure]=
	(-(1+sens uw g[female])*(av daily work hours gs[female,mid]-av daily work hours delay gs\
		[female,mid]))/Year 1 ~~|
in time use dt[inc mid e m,leisure]=
	(-(1+sens uw g[male])*(av daily work hours gs[male,mid]-av daily work hours delay gs\
		[male,mid]))/Year 1 ~~|
in time use dt[inc hig e f,leisure]=
	(-(1+sens uw g[female])*(av daily work hours gs[female,hig]-av daily work hours delay gs\
		[female,hig]))/Year 1 ~~|
in time use dt[inc hig e m,leisure]=
	(-(1+sens uw g[male])*(av daily work hours gs[male,hig]-av daily work hours delay gs\
		[male,hig]))/Year 1 ~~|
in time use dt[inc low u f, unpaid w]=
	(redist of uw d[inc low u f])/Year 1 ~~|
in time use dt[inc low u m, unpaid w]=
	redist of uw d[inc low u m]/Year 1 ~~|
in time use dt[inc mid u f, unpaid w]=
	redist of uw d[inc mid u f]/Year 1 ~~|
in time use dt[inc mid u m, unpaid w]=
	redist of uw d[inc mid u m]/Year 1 ~~|
in time use dt[inc hig u f, unpaid w]=
	redist of uw d[inc hig u f]/Year 1 ~~|
in time use dt[inc hig u m, unpaid w]=
	redist of uw d[inc hig u m]/Year 1 ~~|
in time use dt[inc low u f, leisure]=
	-redist of uw d[inc low u f]/Year 1 ~~|
in time use dt[inc low u m, leisure]=
	-redist of uw d[inc low u m]/Year 1 ~~|
in time use dt[inc mid u f, leisure]=
	-redist of uw d[inc mid u f]/Year 1 ~~|
in time use dt[inc mid u m, leisure]=
	-redist of uw d[inc mid u m]/Year 1 ~~|
in time use dt[inc hig u f, leisure]=
	-redist of uw d[inc hig u f]/Year 1 ~~|
in time use dt[inc hig u m, leisure]=
	-redist of uw d[inc hig u m]/Year 1 ~~|
