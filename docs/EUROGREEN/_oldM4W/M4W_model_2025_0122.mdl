P1=
	RANDOM NORMAL( 937 , 1072 , mean P, 29.5 , seed )
	~	
	~	The statistics of total annual precipitation (P) are used in the period \
		1951-2022. It is assumed that precipitation follows a normal distribution. \
		From this distribution, synthetic precipitation series are generated, with \
		which evapotranspiration is estimated from a linear relationship.
	|

coeff T=
	21.3139
	~	
	~		|

Wd Extended SW tot Mm3=
	Wdem BLUE SW tot + Wdem GREY SW tot - WRestitution SW Mm3
	~	
	~		|

WRestitution GW Mm3 i[ind]=
	rGW i[ind]*y real i[ind]/1e+06
	~	
	~		|

Wd Extended GW tot Mm3=
	Wdem BLUE GW tot + Wdem GREY GW tot - WRestitution GW Mm3
	~	
	~		|

WRestitution GW Mm3=
	sum(WRestitution GW Mm3 i[ind!])
	~	
	~		|

coefficient of Dilution SW i[ind]=
	rSW i[ind]*
	(k2 SW i[ind]*CP SW i[ind] - Cs SW i[ind])/
	(k1 SW i[ind]*Cs SW i[ind] - Co SW)
	~	
	~		|

rGW i[ind] :EXCEPT:     [agri]=
	pseudo rGW[ind]*coeff intens BLUE GW i[ind] ~~|
rGW i[agri]=
	alpha AGR*(coeff intens BLUE GW i[agri] + coeff intens BLUE SW i[agri])
	~	
	~	discharges into the water body GW associated with industry i
	|

rSW i[ind]=
	coeff intens BLUE SW i[ind]*pseudo rSW[ind]
	~	
	~		|

WRestitution SW Mm3=
	sum(WRestitution SW Mm3 i[ind!])
	~	
	~		|

WRestitution SW Mm3 i[ind]=
	rSW i[ind]*y real i[ind]/1e+06
	~	
	~		|

feasible GW Mm3=
	coeff conv mm to Mm3*
	(
	IF THEN ELSE( GW recharge I < mean I*(1 - range I),  
	              mean I*(1 - range I),   
	
	             IF THEN ELSE( GW recharge I > mean I*(1+range I),  
	             mean I*(1+range I),
	    
	             GW recharge I)  
	              
	             )
	)
	~	
	~		|

feasible SW Mm3=
	coeff conv mm to Mm3*
	(
	IF THEN ELSE(eco flow R * mean R > SW runoff R, 0,
	
	             IF THEN ELSE( SW runoff R > (max R + eco flow R)*mean R,
	             max R*mean R,
	   
	             SW runoff R - eco flow R*mean R
	                         )  
	              
	             )
	)
	~	
	~		|

feasible Water Supply Mm3=
	feasible GW Mm3 + feasible SW Mm3
	~	
	~		|

WStress Tot perc=
	ZIDZ( ( Wd Extended SW tot Mm3 + Wd Extended GW tot Mm3 ), feasible Water Supply Mm3\
		 )*100
	~	
	~		|

Wd Extended Tot Mm3=
	Wd Extended GW tot Mm3 + Wd Extended SW tot Mm3
	~	
	~	million of meter cube
	|

WStress GW perc=
	ZIDZ(Wd Extended GW tot Mm3, feasible GW Mm3 )*100
	~	
	~	water stress percentage for groundwater
	|

WStress SW perc=
	ZIDZ(Wd Extended SW tot Mm3, feasible SW Mm3 )*100
	~	
	~	water stress percentage for surface
	|

GFCF real i[ind] :EXCEPT:      [public],[education],[health]=
	IF THEN ELSE(Time=10*Year 1,
	             GFCF real i delay[ind]*(1+c19 shock inv),
	             IF THEN ELSE(Time=11*Year 1,
	                          GFCF real i delay[ind]*(1+c19 shock inv),
	                          min(I desired i[ind],I max i[ind])
	                          )
	              ) ~~|
GFCF real i[public]=
	IF THEN ELSE(Time=10*Year 1,
	             GFCF real i delay[public]*(1+c19 shock inv),
	             IF THEN ELSE(Time=11*Year 1,
	                          GFCF real i delay[public]*(1+c19 shock inv),
	                          I desired i[public]
	                          )
	              ) ~~|
GFCF real i[education]=
	IF THEN ELSE(Time=10*Year 1,
	             GFCF real i delay[education]*(1+c19 shock inv),
	             IF THEN ELSE(Time=11*Year 1,
	                          GFCF real i delay[education]*(1+c19 shock inv),
	                          I desired i[education]
	                          )
	              ) ~~|
GFCF real i[health]=
	IF THEN ELSE(Time=10*Year 1,
	             GFCF real i delay[health]*(1+c19 shock inv),
	             IF THEN ELSE(Time=11*Year 1,
	                          GFCF real i delay[health]*(1+c19 shock inv),
	                        I desired i[health]
	                          )
	              )
	~	Euro constant
	~	actual GFCF real
	|

ratio I=
	GW recharge I/mean I
	~	
	~		|

ratio R=
	SW runoff R/mean R
	~	
	~		|

beta dp[inc cat,coicop] :EXCEPT:           [inc cat, p electgas],[inc cat, p transport\
		]=
	basic beta dp[inc cat,coicop]
	*(1 + elast beta p[coicop]*(infl cumulative p[coicop] - av infl cumulative d[inc cat\
		])/(euro 1/goods 1) )
	+
	basic beta dp[inc cat,coicop]
	*sum(-elast beta p[coicop!]*(infl cumulative p[coicop!]-av infl cumulative d[inc cat\
		])*basic beta dp[inc cat,coicop!]/(euro 1/goods 1))
	- (share elgas * sens JG * ln((People 1+JG L tot)/People 1)*basic beta dp[inc cat,p electgas\
		]+(1- share elgas) * sens JG * ln((People 1+JG L tot)/People 1)*basic beta dp[inc cat\
		,p transport]) * basic beta dp[inc cat,coicop]/sum(basic beta dp[inc cat,coicop!]) ~~|
beta dp[inc cat,p electgas]=
	basic beta dp[inc cat,p electgas]
	*(1 + elast beta p[p electgas]*(infl cumulative p[p electgas] - av infl cumulative d\
		[inc cat])/(euro 1/goods 1) )
	+
	basic beta dp[inc cat,p electgas]
	*sum(-elast beta p[coicop!]*(infl cumulative p[coicop!]-av infl cumulative d[inc cat\
		])*basic beta dp[inc cat,coicop!]/(euro 1/goods 1))
	+
	share elgas * sens JG * ln((People 1+JG L tot)/People 1)*basic beta dp[inc cat,p electgas\
		] ~~|
beta dp[inc cat,p transport]=
	basic beta dp[inc cat,p transport]
	*(1 + elast beta p[p transport]*(infl cumulative p[p transport] - av infl cumulative d\
		[inc cat])/(euro 1/goods 1) )
	+
	basic beta dp[inc cat,p transport]
	*sum(-elast beta p[coicop!]*(infl cumulative p[coicop!]-av infl cumulative d[inc cat\
		])*basic beta dp[inc cat,coicop!]/(euro 1/goods 1))
	+
	(1- share elgas) * sens JG * ln((People 1+JG L tot)/People 1)*basic beta dp[inc cat,\
		p transport]
	~	Dmnl
	~	shares of consumption expenditure spend on respective COICOP
	|

p i[ind] :EXCEPT:        [mining],[electricity]=
	max(((euro 1+markup i[ind])*(1+vat rate[ind])*UFC delay i[ind])/p init i[ind],p i delay\
		[ind]) ~~|
p i[mining]=
	IF THEN ELSE(
	Time>=Time shock,
	(1+Delta UCC i[mining]) * max(((euro 1+markup i[mining])*(1+vat rate[mining])*UFC delay i\
		[mining])/p init i[mining],p i delay[mining])
	*(1+price shock*Act Price Shock),
	(1+Delta UCC i[mining]) * max(((euro 1+markup i[mining])*(1+vat rate[mining])*UFC delay i\
		[mining])/p init i[mining],p i delay[mining])) ~~|
p i[electricity]=
	IF THEN ELSE(Time>=Time shock,
	(1+Delta UCC i[electricity])*max(((euro 1+markup i[electricity])*(1+vat rate[electricity\
		])*UFC delay i[electricity])/p init i[electricity],p i delay[electricity])*(1+price shock\
		*Act Price Shock),
	(1+Delta UCC i[electricity])*max(((euro 1+markup i[electricity])*(1+vat rate[electricity\
		])*UFC delay i[electricity])/p init i[electricity],p i delay[electricity]))
	~	Euro/Good
	~	price of NACE industry: (euro 1+markup i[ind])*(1+vat rate[ind])*UFC delay i[ind]* \
		Euro constant 1/euro 1
		
		previous forula 05/04/23
		(1+Delta UCC i[ind])*max(((euro 1+markup i[ind])*(1+vat rate[ind])*UFC \
		delay i[ind])/p init i[ind],p i delay[ind])
	|

Wdem GREY GW i[ind] :EXCEPT: [agri]=
	0 ~~|
Wdem GREY GW i[agri]=
	coefficient of Dilution GW i[agri]*y real i[agri]/1e+06
	~	
	~		|

Co GW=
	IF THEN ELSE(ratio I < 0.5, 15 , 
	             IF THEN ELSE( ratio I < 1.5, 
	                           const Co GW + coeff Co*ratio I , 
	                           25                        
	                         ) 
	             )
	~	
	~	COD concentration in water body k for year t
		min ratio = 0.5 then Co min = 15 mg/l
		max ratio = 1.5 then Co = linear function or Co max = 25
	|

Co SW=
	IF THEN ELSE(ratio R < 0.5, 15 , 
	             IF THEN ELSE( ratio R < 1.5, 
	                           const Co GW + coeff Co*ratio R , 
	                           25                        
	                         ) 
	             )
	~	
	~	check!
		COD concentration in water body k for year t
	|

Wdem BLUE GW tot=
	sum(Wdem BLUE GW Mm3 i[ind!])
	~	
	~		|

GWB i[ind] :EXCEPT:  [public]=
	sum(GWB gis[gender!,ind,skill!]) ~~|
GWB i[public]=
	sum(GWB gis[gender!,public,skill!])+ JG L tot *wage JG*hours mean/People 1/Hours 1
	~	Euro
	~		|

Z real ii[ind,toind] :EXCEPT:    [ind,finance]=
	a ii[ind,toind]*y real i[toind] ~~|
Z real ii[ind,finance]=
	IF THEN ELSE( Financial income switch=0,
	            a ii[ind,finance]*y real i[finance],
	            sum(Financial industry revenue i[ind!]/CPI)
	            )
	~	Euro constant
	~	Interindustry trade matrix, real
	|

Wdem BLUE SW tot=
	sum(Wdem BLUE SW Mm3 i[ind!])
	~	
	~		|

Wdem BLUE Mm3 tot=
	sum(Wdem BLUE Mm3 i[ind!])
	~	
	~		|

const Co GW=
	20 - coeff Co
	~	
	~	Co mean - coeff ratio Co
	|

Wdem GREY GW tot=
	sum(Wdem GREY GW i[ind!])
	~	
	~		|

Wdem GREY i[ind]=
	Wdem GREY GW i[ind] + Wdem GREY SW i[ind]
	~	
	~		|

Wdem GREY SW i[ind]=
	coefficient of Dilution SW i[ind]*y real i[ind]/1e+06
	~	
	~		|

Wdem GREY SW tot=
	sum(Wdem GREY SW i[ind!])
	~	
	~		|

Wdem GREY tot Mm3=
	sum(Wdem GREY i[ind!])
	~	
	~		|

in time use dt[inc cat,timeuse] :EXCEPT:      [inc low u f, unpaid w], [inc low u f, \
		leisure],
[inc low u m, unpaid w], [inc low u m, leisure],
[inc mid u f,unpaid w], [inc mid u f,leisure],
[inc mid u m,unpaid w], [inc mid u m,leisure],
[inc hig u f,unpaid w], [inc hig u f,leisure], 
[inc hig u m,unpaid w], [inc hig u m,leisure],
