	IF THEN ELSE(Time<7*Year 1,"corp tax rate 2010-2016",corp tax rate from 2017)*IF THEN ELSE\
		(Time<S Time Policy start,
	                1,
	                1+min(S Time end-S Time Policy start,Time-S Time Policy start)*(S corp tax rate\
		/(S Time end-S Time Policy start))
