change coeff BLUE GW agr=
	IF THEN ELSE( mean P > P, 
	ratio GW i[agri]*
	( coeff adj GREEN agr*coeff irrigation eff*(1 - P/mean P) ) +
	  coeff adj BLUE GW i[agri]*(PET/mean PET - 1),
	
	ratio GW i[agri]*coeff adj BLUE GW i[agri]*(PET/mean PET - 1)
	
	)
	~	
	~		|

change coeff BLUE SW agr=
	IF THEN ELSE( mean P > P, 
	ratio SW i[agri]*
	( coeff adj GREEN agr*coeff irrigation eff*(1 - P/mean P) ) +
	  coeff adj BLUE SW i[agri]*(1 - PET/mean PET),
	
	ratio SW i[agri]*coeff adj BLUE SW i[agri]*(1 - PET/mean PET)
	)
	~	
	~		|

