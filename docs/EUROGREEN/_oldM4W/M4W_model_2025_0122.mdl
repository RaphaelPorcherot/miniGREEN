cap prod i[ind]=
	0.329927,	0.460296,	2.64301,	2.47524,	0.595301,	0.595301,	4.47758,	2.48224,	0.658742\
		,	1.26651,	2.12413,	2.0744,	0.105889,	2.94466,	0.312452,	2.80379,	2.16612,	1.46391,\
			3.3367
