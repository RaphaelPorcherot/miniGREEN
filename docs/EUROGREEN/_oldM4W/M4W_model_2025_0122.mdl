	+mixed income per capita d[inc mid p f]+
	net CT d delay[inc mid p f]
	+IF THEN ELSE(Time<S Time Policy start,Euro 0,Act BI*BI per capita) ~~|
yd d[inc mid p m]=
	(ZIDZ(GPB gs[male,mid],"Skills 65+ gs"[male,mid])*People 1)-inc tax p gs[male,mid]
	+(ZIDZ(net fin inc gs[male,mid],adult population gs[male,mid])*People 1)
	+mixed income per capita d[inc mid p m]+
	net CT d delay[inc mid p m]
	+IF THEN ELSE(Time<S Time Policy start,Euro 0,Act BI*BI per capita) ~~|
yd d[inc hig p f]=
	(ZIDZ(GPB gs[female,hig],"Skills 65+ gs"[female,hig])*People 1)-inc tax p gs[female,\
		hig]
	+(ZIDZ(net fin inc gs[female,hig],adult population gs[female,hig])*People 1)
	+mixed income per capita d[inc hig p f]+
	net CT d delay[inc hig p f]
	+IF THEN ELSE(Time<S Time Policy start,Euro 0,Act BI*BI per capita) ~~|
yd d[inc hig p m]=
	(ZIDZ(GPB gs[male,hig],"Skills 65+ gs"[male,hig])*People 1)-inc tax p gs[male,hig]
	+(ZIDZ(net fin inc gs[male,hig],adult population gs[male,hig])*People 1)
	+mixed income per capita d[inc hig p m]+
	net CT d delay[inc hig p m]
	+IF THEN ELSE(Time<S Time Policy start,Euro 0,Act BI*BI per capita) ~~|
yd d[inc cap]=
	(ZIDZ(net fin inc cap,pop cap))*People 1
	+mixed income per capita d[inc cap]+
	net CT d delay[inc cap]
	+IF THEN ELSE(Time<S Time Policy start,Euro 0,Act BI*BI per capita)
	~	Euro
	~	individual disposable income by income category
	|

yd delay d[inc cat]= DELAY FIXED (
	yd d[inc cat], Year 1 , yd initial d[inc cat])
	~	Euro
	~		|

yd delay2 d[inc cat]= DELAY FIXED (
	yd d[inc cat], Year 1+Year 1 , yd initial d[inc cat])
	~	Euro
	~		|

yd initial d[inc cat]= INITIAL(
	yd d[inc cat])
	~	Euro
	~		|

