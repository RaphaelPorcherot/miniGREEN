	|

savings cap=
	(yd d[inc cap]-c tot d[inc cap])*pop d[inc cap]/People 1
	~	Euro
	~	capitalists savings
	|

savings gs[male,low]=
	((yd d[inc low u m]-c tot d[inc low u m])*pop d[inc low u m]
	+(yd d[inc low e m]-c tot d[inc low e m])*pop d[inc low e m]
	+(yd d[inc low o m]-c tot d[inc low o m])*pop d[inc low o m]
	+(yd d[inc low p m]-c tot d[inc low p m])*pop d[inc low p m])/(People 1*Year 1) ~~|
savings gs[male,mid]=
	((yd d[inc mid u m]-c tot d[inc mid u m])*pop d[inc mid u m]
	+(yd d[inc mid e m]-c tot d[inc mid e m])*pop d[inc mid e m]
	+(yd d[inc mid o m]-c tot d[inc mid o m])*pop d[inc mid o m]
	+(yd d[inc mid p m]-c tot d[inc mid p m])*pop d[inc mid p m])/(People 1*Year 1) ~~|
savings gs[male,hig]=
	((yd d[inc hig u m]-c tot d[inc hig u m])*pop d[inc hig u m]
	+(yd d[inc hig e m]-c tot d[inc hig e m])*pop d[inc hig e m]
	+(yd d[inc hig o m]-c tot d[inc hig o m])*pop d[inc hig o m]
	+(yd d[inc hig p m]-c tot d[inc hig p m])*pop d[inc hig p m])/(People 1*Year 1) ~~|
savings gs[female,low]=
	((yd d[inc low u f]-c tot d[inc low u f])*pop d[inc low u f]
	+(yd d[inc low e f]-c tot d[inc low e f])*pop d[inc low e f]
	+(yd d[inc low o f]-c tot d[inc low o f])*pop d[inc low o f]
	+(yd d[inc low p f]-c tot d[inc low p f])*pop d[inc low p f])/(People 1*Year 1) ~~|
savings gs[female,mid]=
	((yd d[inc mid u f]-c tot d[inc mid u f])*pop d[inc mid u f]
	+(yd d[inc mid e f]-c tot d[inc mid e f])*pop d[inc mid e f]
	+(yd d[inc mid o f]-c tot d[inc mid o f])*pop d[inc mid o f]
	+(yd d[inc mid p f]-c tot d[inc mid p f])*pop d[inc mid p f])/(People 1*Year 1) ~~|
savings gs[female,hig]=
	((yd d[inc hig u f]-c tot d[inc hig u f])*pop d[inc hig u f]
	+(yd d[inc hig e f]-c tot d[inc hig e f])*pop d[inc hig e f]
	+(yd d[inc hig o f]-c tot d[inc hig o f])*pop d[inc hig o f]
	+(yd d[inc hig p f]-c tot d[inc hig p f])*pop d[inc hig p f])/(People 1*Year 1)
	~	Euro/Year
	~	total savings per skill level
	|

scalling lambda=
	0.8*IF THEN ELSE
	(Time<S Time Policy start,
	                1,
	                1-min(S Time end-S Time Policy start,Time-S Time Policy start)*(S scalling lambda\
		/(S Time end-S Time Policy start
	))
	                )
	~	Dmnl
	~	0,5
	|

scalling tech=
	1*IF THEN ELSE(Time<S Time Policy start,
	                1,
	                1+min(S Time end-S Time Policy start,Time-S Time Policy start)*(S scalling A\
		/(S Time end-S Time Policy start))
	                )
	~	Dmnl
	~	1/a_ii_delay[ind,ind]
	|

