	~	Dmnl
	~	This coefficient gives us the ratio between the standard deviation/average wages gis.
		One standard deviation is thus equal to the coefficient*average wage.
	|

average wage changes gis[gender,ind,skill]=
	difference wage min wage gis[gender,ind,skill]/(Coefficient wage dispersion[gender,ind\
		,skill]*wage delay gis[gender,ind,skill])*euro 1
	~	Euro
	~		|

Minimum Wage Value=
	
	IF THEN ELSE(Time <S Time Policy start,0* euro 1 ,Act minimum wage * min wage level)
	~	Euro
	~		|

Euro good 1=
	1
	~	Euro/Good
	~		|

