	             init other benefits per cap*(1+inflation delay),
	             (1-Act BI)*init other benefits per cap*(1+inflation delay)
	             )
	~	Euro
	~		|

out Loans i[ind]=
	IF THEN ELSE(debt i[ind]-profits residual[ind]-debt repayment i[ind]<0*euro 1,0*euro 1\
		,profits residual[ind])+debt repayment i[ind]
	~	Euro
	~		|

out RES public i[ind]= DELAY FIXED (
	in RES public i[ind], Average life of plant , 0* tj 1/Year 1)
	~	TJ/Year
	~		|

output to GDP ratio=
	tot y real/GDP real
	~	percentage
	~		|

output to intermediate demand ratio i[ind]=
	max(1,ZIDZ(y nom i[ind],z demand nom i[ind]))
	~	percentage
	~		|

output to intermediate demand total=
	sum(y nom i[ind!])/sum(z demand nom i[ind!])
	~	percentage
	~		|

p ETS=
	IF THEN ELSE(Act carbon tax = 0, pETS forecast(Time/ Year 1)*euro 1, 
	             IF THEN ELSE(Time <10*Year 1, pETS forecast(Time/Year 1)* euro 1, 
	                             carbon tax rate)
	            )
	~	Euro
	~		|

p i delay[ind]= DELAY FIXED (
