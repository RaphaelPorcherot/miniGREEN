	~	Dmnl
	~		|

prob T2 i[ind]= INTEG (
	IF THEN ELSE(prob T2 i[ind]+(-g relative UC i[ind]*sens prob)<0,(-prob T2 i[ind]+0.05\
		)/Year 1,
	IF THEN ELSE(prob T2 i[ind]+(-g relative UC i[ind]*sens prob)>1,(0.95-prob T2 i[ind]\
		)/Year 1,
	((-g relative UC i[ind]*sens prob))/Year 1)),
		initial prob T2 i)
	~	Dmnl
	~	probability of T2 to emerge
	|

prob T3 i[ind]= INTEG (
	IF THEN ELSE(prob T3 i[ind]+(g relative UC i[ind]*sens prob)<0,(-prob T3 i[ind]+0.05\
		)/Year 1,
	IF THEN ELSE(prob T3 i[ind]+(g relative UC i[ind]*sens prob)>1,(0.95-prob T3 i[ind])\
		/Year 1,
	((g relative UC i[ind]*sens prob)/Year 1)+ IF THEN ELSE(Time<S Time Policy start,0/Year 1\
		,(Act en eff*en eff size/Year 1)))),
		initial prob T3 i)
	~	Dmnl
	~	probability of T3 to emerge
	|

prob T4 i[ind]=
	prob T2 i[ind]*prob T3 i[ind]
	~	Dmnl
	~	probability of T4 to emerge (joint probability of T2 and T3)
