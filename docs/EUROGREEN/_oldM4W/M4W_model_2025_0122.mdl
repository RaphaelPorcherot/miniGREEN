"Skills 65+ gs"[gender,skill]= INTEG (
	+"in skills 65+ gs"[gender,skill]-"deaths 65+ gs"[gender,skill],
		"Pop 65+ g"[gender]*init distr skill cgs[p65,gender,skill]*0.99)
	~	People
	~		|

a delay2 ii[ind,toind]= DELAY FIXED (
	a delay ii[ind,toind], Year 1+Year 1, initial a delay ii[ind,toind])
	~	Dmnl
	~		|

in skills 1425 gs[gender,low]=
	maturation014 g[gender]*
	((Skills 1524 gs[gender,low]/sum(Skills 1524 gs[gender,skill!]))
	*smooth((1 + sens skill cs[low]*(u s[mid]-u s[low])),duration skill transition)
	+
	trend entry skill gs[gender,low]) ~~|
in skills 1425 gs[gender,hig]=
	maturation014 g[gender]*
	((Skills 1524 gs[gender,hig]/sum(Skills 1524 gs[gender,skill!]))
	*(1+sens skill cs[hig]*(u s[mid]-u s[hig]))
	+trend entry skill gs[gender,hig]) ~~|
in skills 1425 gs[gender,mid]=
	maturation014 g[gender]*(1-
	((Skills 1524 gs[gender,low]/sum(Skills 1524 gs[gender,skill!]))
	*(1+sens skill cs[low]*(u s[mid]-u s[low]))
	+trend entry skill gs[gender,low])
	-
	((Skills 1524 gs[gender,hig]/sum(Skills 1524 gs[gender,skill!]))
	*(1+sens skill cs[hig]*(u s[mid]-u s[hig]))
	+trend entry skill gs[gender,hig])
	)
	~	People/Year
	~		|

Skills 1524 gs[gender,low]= INTEG (
	Skills 1524 gs[gender,low]*smooth(sens skill cs[low]*(u s[mid]-u s[low]),duration skill transition\
		)/Year 1
	+
	in skills 1425 gs[gender,low] - in skills 2544 gs[gender,low] - deaths 1524 gs[gender\
		,low],
		Pop 1524 g[gender]*init distr skill cgs[p1524,gender,low]*0.99) ~~|
Skills 1524 gs[gender,hig]= INTEG (
	Skills 1524 gs[gender,hig]*smooth(sens skill cs[hig]*(u s[mid]-u s[hig]),duration skill transition\
		)/Year 1
	+in skills 1425 gs[gender,hig]-in skills 2544 gs[gender,hig]-deaths 1524 gs[gender,hig\
		],
		Pop 1524 g[gender]*init distr skill cgs[p1524,gender,hig]) ~~|
Skills 1524 gs[gender,mid]= INTEG (
	-Skills 1524 gs[gender,low]*smooth(sens skill cs[low]*(u s[mid]-u s[low]),duration skill transition\
		)/Year 1
	-Skills 1524 gs[gender,hig]*smooth(sens skill cs[hig]*(u s[mid]-u s[hig]),duration skill transition\
		)/Year 1
	+in skills 1425 gs[gender,mid]-deaths 1524 gs[gender,mid]-in skills 2544 gs[gender,mid\
		],
		Pop 1524 g[gender]*init distr skill cgs[p1524,gender,mid])
	~	People
	~		|

Skills 2544 gs[gender,low]= INTEG (
	Skills 2544 gs[gender,low]*smooth(sens skill cs[low]*(u s[mid]-u s[low]),duration skill transition\
		)/Year 1
	+in skills 2544 gs[gender,low]-in skills 4564 gs[gender,low]-deaths 2544 gs[gender,low\
		],
		Pop 2544 g[gender]*init distr skill cgs[p2544,gender,low]*0.99) ~~|
Skills 2544 gs[gender,hig]= INTEG (
	Skills 2544 gs[gender,hig]*smooth(sens skill cs[hig]*(u s[mid]-u s[hig]),duration skill transition\
		)/Year 1
	+in skills 2544 gs[gender,hig]-in skills 4564 gs[gender,hig]-deaths 2544 gs[gender,hig\
		],
		Pop 2544 g[gender]*init distr skill cgs[p2544,gender,hig]) ~~|
Skills 2544 gs[gender, mid]= INTEG (
	-Skills 2544 gs[gender,low]*smooth(sens skill cs[low]*(u s[mid]-u s[low]),duration skill transition\
		)/Year 1
	-Skills 2544 gs[gender,hig]*smooth(sens skill cs[hig]*(u s[mid]-u s[hig]),duration skill transition\
		)/Year 1
	+in skills 2544 gs[gender,mid]-deaths 2544 gs[gender,mid]-in skills 4564 gs[gender,mid\
		],
		Pop 2544 g[gender]*init distr skill cgs[p2544,gender,mid])
	~	People
	~		|

duration skill transition=
	3
	~	Year
	~		|

initial year=
	0
	~	Year
	~		|

conversion=
	1e+09
	~	Euro
	~		|

in adapation=
	-adaptation sensitivity*adaptation exp/conversion
	~	Dmnl/Year
	~		|

in skills 2544 gs[gender,low]=
	(Skills 1524 gs[gender,low]/cohort years c[p1524])*(1+sens skill cs[low]*(u s[mid]-u s\
		[low])) ~~|
in skills 2544 gs[gender,hig]=
	(Skills 1524 gs[gender,hig]/(10*Year 1))*(1+sens skill cs[hig]*(u s[mid]-u s[hig])) ~~|
in skills 2544 gs[gender,mid]=
	sum(Skills 1524 gs[gender,skill!])/(10*Year 1)
	-(Skills 1524 gs[gender,low]/(10*Year 1))*(1+sens skill cs[low]*(u s[mid]-u s[low]))
	-(Skills 1524 gs[gender,hig]/(10*Year 1))*(1+sens skill cs[hig]*(u s[mid]-u s[hig]))
	~	People/Year
	~		|

initial adaptation=
	1
	~	Dmnl
	~		|

Year 1=
	1
	~	Year
	~		|

adaptation exp=
	IF THEN ELSE(Time<(S Time Policy start), 0*euro 1,IF THEN ELSE(Time<S Time Policy start\
		 + duration adapt,yearly exp adapt*Act adapt,0*euro 1))
	~	Euro
	~		|

no action=
	0
	~	Euro
	~		|

adaptation= INTEG (
	in adapation,
		initial adaptation)
	~	Dmnl
	~		|

Skills 4564 gs[gender,low]= INTEG (
	Skills 4564 gs[gender,low]*smooth(sens skill cs[low]*(u s[mid]-u s[low]),duration skill transition\
		)/Year 1
	+in skills 4564 gs[gender,low]-"in skills 65+ gs"[gender,low]-deaths 4564 gs[gender,\
		low],
		Pop 4564 g[gender]*init distr skill cgs[p4564,gender,low]*0.99) ~~|
Skills 4564 gs[gender,hig]= INTEG (
	Skills 4564 gs[gender,hig]*smooth(sens skill cs[hig]*(u s[mid]-u s[hig]),duration skill transition\
		)/Year 1
	+in skills 4564 gs[gender,hig]-"in skills 65+ gs"[gender,hig]-deaths 4564 gs[gender,\
		hig],
		Pop 4564 g[gender]*init distr skill cgs[p4564,gender,hig]) ~~|
Skills 4564 gs[gender, mid]= INTEG (
	-Skills 4564 gs[gender,low]*smooth(sens skill cs[low]*(u s[mid]-u s[low]),duration skill transition\
		)/Year 1
	-Skills 4564 gs[gender,hig]*smooth(sens skill cs[hig]*(u s[mid]-u s[hig]),duration skill transition\
		)/Year 1
	+in skills 4564 gs[gender,mid]-deaths 4564 gs[gender,mid]-"in skills 65+ gs"[gender,\
		mid],
		Pop 4564 g[gender]*init distr skill cgs[p4564,gender,mid])
	~	People
	~		|

uc delay i[ind]= DELAY FIXED (
	uc i[ind], Year 1 , initial uc[ind])
	~	Dmnl
	~		|

elegible CT groups=
	IF THEN ELSE(threshold eligible CT redistrib=1,tax floor 3,tax floor 6)
	~	Euro
	~		|

eligible CT d[inc cat]=
	IF THEN ELSE( yd delay d[inc cat]<elegible CT groups ,1,0)
	~	Dmnl
	~		|

threshold eligible CT redistrib=
	1
	~	Dmnl
	~	1 = benefit to all below xxxx
		2 = benefit for all
	|

wage min[gender,ind,"skill & cap"]=
	IF THEN ELSE (Time<(13*Year 1),Euro 0,Euro 0)
	~	Euro
	~		|

damage=
	IF THEN ELSE(temp RCP scenario=0,0,1)
	~	Dmnl
	~	0 --> no damage
		1 --> damage
		2 --> double damage
	|

Act fin tax=
	0
	~	Dmnl
	~	0: inactive
		1: active
	|

Act cons red=
	0
	~	Dmnl
	~	Not active = 0
		Active = 1
	|

phase product[solid]=
	phaseout carbon ~~|
phase product[liquid]=
	phaseout oil ~~|
phase product[gas]=
	phaseout gas ~~|
phase product[biomass]=
	phaseout bio
	~	Dmnl
	~	1- phase out respective energy products EXCEPT for renew
	|

phaseout bio=
	1
	~	Dmnl
	~		|

phaseout carbon=
	1
	~	Dmnl
	~		|

phaseout gas=
	1
	~	Dmnl
	~		|

phaseout oil=
	1
	~	Dmnl
	~		|

into share hh[nrg]=
	IF THEN ELSE(Time<>(S Time Policy start),0,share sources Ed fd hh nrg[nrg])
	~	Dmnl
	~		|

into share nrg i[nrg,ind]=
	IF THEN ELSE(Time<>(S Time Policy start),0,Share source Ed Z nrg i[nrg,ind])
	~	Dmnl
	~		|

share at time of policy nrg i[nrg,ind]= INTEG (
	into share nrg i[nrg,ind]/Year 1,
		0)
	~	Dmnl
	~		|

policy start share nrg[nrg]=
	IF THEN ELSE(Time=S Time Policy start,into share hh[nrg],share at time of policy hh nrg\
		[nrg])
	~	Dmnl
	~		|

share at time of policy hh nrg[nrg]= INTEG (
	into share hh[nrg]/Year 1,
		0)
	~	Dmnl
	~		|

policy start share nrg i[nrg,ind]=
	IF THEN ELSE(Time=S Time Policy start,into share nrg i[nrg,ind],share at time of policy nrg i\
		[nrg,ind])
	~	Dmnl
	~		|

a delay ii[ind,toind]= DELAY FIXED (
	a ii[ind,toind], Year 1, initial a ii[ind,toind])
	~	Dmnl
	~		|

a diffusion ii[ind,toind]=
	(techn frontier a ii[ind,toind] *(K i[ind]-(1-depreciation rates i[ind]*Year 1)*K delay i\
		[ind])
	+ a delay ii[ind,toind] *(1-depreciation rates i[ind]*Year 1)*K delay i[ind])
	/K i[ind]
	~	Dmnl
	~	continuous effect of implentation/diffusion in the absense of a new technological \
		frontier/ a new technology being adopted
		-> new a ii
		(techn_frontier_a_ii[ind,toind] \
		*(K_i[ind]-(1-depreciation_rates_i[ind])*K_delay_i[ind])
		+ a_delay_ii[ind,toind] *(1-depreciation_rates_i[ind])*K_delay_i[ind])
		/K_i[ind]
	|

a no diffusion no damage ii[ind,toind]= INTEG (
	0,
		initial a ii[ind,toind])
	~	Dmnl [0,?]
	~	technical coefficients
		IF THEN ELSE(T i[ind]=UFC T iv[ind,T1], a diffusion ii[ind,toind]/Year 1 , 
		IF THEN ELSE( T i[ind]=UFC T iv[ind,T2] , delta a T2 ii[ind,toind]/Year 1 , 
		IF THEN ELSE( T i[ind]=UFC T iv[ind,T3] , delta a T3 ii[ind,toind]/Year 1 ,
		delta a T4 ii[ind,toind]/Year 1 )))
	|

accum tech coeff growth rate[ind,toind]=
	(a ii[ind,toind]-initial a ii[ind,toind])/initial a ii[ind,toind]
	~	Dmnl
	~		|

Act adapt=
	0
	~	Dmnl
	~	1--> active
		0 --> inactive
	|

Act BI=
	0
	~	Dmnl
	~	0 - inactive
		1 - active (financed by Income Tax, Act wealth tax to have it financed by \
		the wealth tax and cancel the increase in income tax)
	|

Act carbon tax=
	0
	~	Dmnl
	~	0 = inactive
		1 = active
	|

Act CT redistrib=
	0
	~	Dmnl
	~	0 = inactive
		1 = active
