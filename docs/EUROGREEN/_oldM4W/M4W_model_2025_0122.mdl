	L i[ind]*max(skill trend is[ind,skill],0)
	~	People [0,?]
	~	employment by industry and skill
	|

L s[skill]=
	sum(L is[ind!,skill])
	~	People
	~		|

L T gisv[gender,ind,skill,techn]=
	L T isv[ind,skill,techn]*male share delay is[ind,skill]
	~	People
	~		|

L T isv[ind,skill,techn]=
	L T iv[ind,techn]*max(skill trend delay is[ind,skill],0)
	~	People
	~		|

L T iv[ind,T1]=
	y real delay i[ind]/(lambda T iv[ind,T1]*hours i[ind]) ~~|
L T iv[ind,T2]=
	y real delay i[ind]/(lambda T iv[ind,T2]*hours i[ind]) ~~|
L T iv[ind,T3]=
	y real delay i[ind]/(lambda T iv[ind,T3]*hours i[ind]) ~~|
L T iv[ind,T4]=
	y real delay i[ind]/(lambda T iv[ind,T4]*hours i[ind])
	~	People
	~		|

L tot=
	sum(L i[ind!])
	~	People
	~		|

L tot check=
	sum(L gis[gender!,ind!,skill!])-L tot
	~	People
	~		|

L u gs[gender,skill]=
	max(50000* People 1,labour supply gs[gender,skill]-L gs[gender,skill])
	~	People
	~	number of unemployed people by gender and skill
	|

lab prod=
	100*(tot y real/(sum(L i[ind!]*hours i[ind!])))/init lab prod
	~	Dmnl
	~		|

labour share=
	(GWB+(sum(soc sec contr employer gis[gender!,ind!,skill!]*L gis[gender!,ind!,skill!]\
		)/People 1))/(GWB+(sum(soc sec contr employer gis[gender!,ind!,skill!]*L gis[gender\
		!,ind!,skill!])/People 1)+Profits
	)
	~	percentage
	~		|

labour supply=
	sum(labour supply gs[gender!,skill!])
	~	People
	~		|

labour supply gs[gender,skill]=
	LFPR gs[gender,skill]*sum(Working age population cgs[cohorts!,gender,skill])-JG L gs\
		[gender,skill]
	~	People
	~		|

lambda delay i[ind]= DELAY FIXED (
	lambda i[ind], Year 1 , initial lambda i[ind])
	~	Goods/People/Hours
	~		|

lambda delay2 i[ind]=
	DELAY FIXED(lambda delay i[ind], Year 1 , initial lambda delay i[ind] )
	~	Goods/People/Hours
	~		|

lambda diffusion i[ind]=
	(techn frontier lambda i[ind] *(K i[ind]-(1/Year 1-depreciation rates i[ind])*K delay i\
		[ind]*Year 1)
	+ lambda delay i[ind] *(1/Year 1-depreciation rates i[ind])*K delay i[ind]* Year 1)
	/K i[ind]/Euro constant 1*(Hours 1*People 1)
	~	Dmnl
	~	continuous effect of implentation/diffusion in the absense of a new technological \
		frontire/ a new technology being adopted
		-> new lambda
		(techn_frontier_lambda_i[ind] \
		*(K_i[ind]-(1-depreciation_rates_i[ind])*K_delay_i[ind])
		+ lambda_delay_i[ind] *(1-depreciation_rates_i[ind])*K_delay_i[ind])
		/K_i[ind]
	|

Leontief ii[ind,toind]=
	INVERT MATRIX(Id minus A ii[ind,toind],19)
	~	Dmnl
	~	Leontief inverse matrix
		
		GET_DIRECT_CONSTANTS('economy.xlsx','technology','B143')
	|

lev delay i[ind]= DELAY FIXED (
	lev i[ind], Year 1 , lev initial i[ind])
	~	Euro/ Euro constant
	~		|

lev i[ind]=
	debt i[ind]/(price capital delay*K i[ind])*euro 1/Euro constant 1
	~	Euro/Euro constant
	~	leverage ratio
	|

lev initial i[ind]=
	Loans initial i[ind]/K initial i[ind]
	~	Euro/ Euro constant
	~		|

LFPR=
	sum(labour supply gs[gender!,skill!]+JG L gs[gender!,skill!])/sum(Working age population cgs\
		[cohorts!,gender!,skill!])
	~	Dmnl
	~		|

LFPR g[gender]=
	sum(labour supply gs[gender,skill!]+ JG L gs[gender,skill!])/sum(Working age population cgs\
		[cohorts!,gender,skill!])
	~	percentage
	~		|

LFPR gs[gender,skill]= INTEG (
	in LFPR gs[gender,skill]+(Transf JG[gender,skill]-Out JG L gs[gender,skill])/sum(Working age population cgs\
		[cohorts!,gender,skill]),
		LFPR initial gs[gender,skill])
	~	percentage
	~	labour force participation rate
	|

