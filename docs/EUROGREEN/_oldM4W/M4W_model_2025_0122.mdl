carbon cost tot i[ind]=
	carbon tax i[ind] +
	CO2 cost ETS i[ind]
	~	Euro
	~		|

Carbon tax hh d[inc cat]=
	Carbon tax hh tot*share c d[inc cat]
	~	Euro
	~		|

Carbon tax hh tot=
	carbon tax rate*CO2 hh tot*1000/Kton 1
	~	Euro
	~	tot co2 tax by hh
	|

carbon tax i[ind]=
	carbon tax rate*CO2 for CT i[ind]*1000/Kton 1
	~	Euro
	~		|

Carbon tax nace=
	sum(carbon tax i[ind!])
	~	Euro
	~		|

carbon tax rate=
	IF THEN ELSE(Time<S Time Policy start,0*euro 1,
	             Act carbon tax*(initial CT + (S carbon tax max - initial CT)*(Time - S Time Policy start\
		-Year 1)/(S Time end - S Time Policy start))
	)
	~	Euro
	~		|

Carbon tax redistrib=
	sum(CT redistrib d[inc cat!])
	~	Euro
	~		|

Carbon tax tot=
	Carbon tax nace + Carbon tax hh tot
	~	Euro
	~		|

case1 i[ind]=
	0
	~	Dmnl
	~	only T1 is available
		(1-draw T2 i[ind])*(1-draw T3 i[ind])*(1-draw T4 i[ind])
	|

case2 i[ind]=
	0
	~	Dmnl
	~	T1 and T2 available
		draw T2 i[ind]*(1-draw T3 i[ind])*(1-draw T4 i[ind])
	|

case3 i[ind]=
	0
	~	Dmnl
	~	T1 and T3 available
		draw T3 i[ind]*(1-draw T2 i[ind])*(1-draw T4 i[ind])
	|

case4 i[ind]=
	0
	~	Dmnl
	~	T1, T2 and T3 available
		draw T2 i[ind]*draw T3 i[ind]*(1-draw T4 i[ind])
	|

case5 i[ind]=
	0
	~	Dmnl
	~	T4 available
		draw T4 i[ind]
	|

case6 i[ind]=
	0
	~	Dmnl
	~	draw T2 i[ind]*(1-draw T3 i[ind])*draw T4 i[ind]
	|

case7 i[ind]=
	0
	~	Dmnl
	~	(1-draw T2 i[ind])*draw T3 i[ind]*draw T4 i[ind]
	|

case8 i[ind]=
	0
	~	Dmnl
	~	draw T2 i[ind]*draw T3 i[ind]*draw T4 i[ind]
	|

CB exp=
	sum(cb gs[gender!,skill!])
	~	Euro
	~		|

cb gs[gender,skill]=
	(IF THEN ELSE(Time<S Time Policy start,
	             sum(Pop 014 g[gender!])*max(0,sum(Working age population cgs[cohorts!,gender\
		,skill])/working age pop total)*benefit per child*(1+inflation delay),
	             (1-Act BI)*sum(Pop 014 g[gender!])*max(0,sum(Working age population cgs\
		[cohorts!,gender,skill])/working age pop total)*benefit per child*(1+inflation delay\
		)
	            ))/People 1
	~	Euro
	~	child benefits received by group
	|

check ct=
	sum(associated GHG cost[ind!,techn!]) - sum(carbon cost tot i[ind!])
	~	Euro
	~		|

check ct red=
