	|

net CT d[inc cat]=
	ZIDZ((Act CT redistrib* (CT redistrib d[inc cat] - Carbon tax hh d[inc cat])),pop d[\
		inc cat])*People 1
	~	Euro
	~		|

net CT d delay[inc cat]= DELAY FIXED (
