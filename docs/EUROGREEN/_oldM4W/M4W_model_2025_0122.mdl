Profits=
	sum(profits i[ind!])
	~	Euro
	~		|

profits i[ind]=
	VA i[ind] - vat i[ind] - 
	sum(GWB gis[gender!,ind,skill!]) -
	(sum(soc sec contr employer gis[gender!,ind,skill!]*L gis[gender!,ind,skill!])/People 1\
		) - 
	carbon cost tot i[ind]+sum(level WTR gov paid gis[gender!,ind,skill!]*hours i[ind]*L gis\
		[gender!,ind,skill!])
	~	Euro
	~		|

profits post debt delay i[ind]=
	post tax profits delay i[ind]-i i[ind]*debt i[ind]-debt repayment i[ind]
	~	Euro
	~	profits post debt repayment/ free for investment
	|

profits residual[ind]=
	IF THEN ELSE(max investment switch =0:OR:1,  
	(1-Div rate)*(profits post debt delay i[ind]-equity to liabilities ratio*I nom i[ind\
		]), 
	(1-Div rate)*(profits post debt delay i[ind]-equity to liabilities ratio^2/(min(equity to liabilities ratio\
		,1-lev delay i[ind]* Euro constant 1 /euro 1))*I nom i[ind])
	)
	~	Euro
	~	residual profits after paying dividents, used to pay outstanding debt
