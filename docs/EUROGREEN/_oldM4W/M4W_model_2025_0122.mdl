I supply nom i[ind]=
	sum(I nom i[ind!])*Inv conversion vector i[ind]+inv pnrr[ind]
	~	Euro
	~	final demand for investment goods.
		check if we are summing the correct side of the matrix.
	|

pnrr[ind]=
	sum(pnrr m[mission!,ind])*Act PNRR
	~	
	~		|

mission:
	m1,m2,m3,m4,m5,m6
	~	
	~		|

Multiplier Innovation=
	0
	~	
	~	Factor that multiplies probability of innovation to make it weaker.
	|

Switch Off Technology=
	0
	~	Dmnl
	~	0 = INACTIVE
		1 = active
	|

Time Markup Shock=
	12
	~	
	~		|

Time shock=
	12
	~	
	~		|

Act Price Shock=
	0
	~	Dmnl
	~	0 = INACTIVE
		1 = active
	|

Act Markup Shock=
	0
	~	Dmnl
	~	0 = INACTIVE
		1 = active
	|

Markup shock=
	IF THEN ELSE(Time=Time shock,1+Markup shock value,
	IF THEN ELSE(Time=(Time shock+1),1.02,
	IF THEN ELSE(Time=(Time shock+2),POWER((1/(1.02*(1+Markup shock value))),(1/5)),
	IF THEN ELSE(Time=(Time shock+3),POWER((1/(1.02*(1+Markup shock value))),(1/5)),
	IF THEN ELSE(Time=(Time shock+4),POWER((1/(1.02*(1+Markup shock value))),(1/5)),
	IF THEN ELSE(Time=(Time shock+5),POWER((1/(1.02*(1+Markup shock value))),(1/5)),
	IF THEN ELSE(Time=(Time shock+6),POWER((1/(1.02*(1+Markup shock value))),(1/5)),
	1
	)))))))
	~	
	~		|

price shock=
	(1 - ramp(1/3,12,15))*Act Price Shock
	~	
	~		|

profit share i[ind]=
	(VA i[ind] - vat i[ind] - 
	sum(GWB gis[gender!,ind,skill!]) -
	(sum(soc sec contr employer gis[gender!,ind,skill!]*L gis[gender!,ind,skill!])/People 1\
		) - 
	carbon cost tot i[ind]+sum(level WTR gov paid gis[gender!,ind,skill!]*hours i[ind]*L gis\
		[gender!,ind,skill!]))/
	(VA i[ind] + vat i[ind] + 
	sum(GWB gis[gender!,ind,skill!]) +(sum(soc sec contr employer gis[gender!,ind,skill!\
		]*L gis[gender!,ind,skill!])/People 1) + 
	carbon cost tot i[ind]+sum(level WTR gov paid gis[gender!,ind,skill!]*hours i[ind]*L gis\
		[gender!,ind,skill!]))
	~	
	~		|

total cost JG=
	JG L tot *wage JG*hours mean
	~	
	~		|

wage JG=
	12
	~	
	~	hourly wage paid by the JG program
	|

level WTR gov paid i[ind]=
	sum(level WTR gov paid gis[gender!,ind,skill!]*L gis[gender!,ind,skill!])*hours i[ind\
		]
	~	
	~		|

ULC i[ind]=
	(ZIDZ((GWB i[ind]-level WTR gov paid i[ind])*(1+ss rate employer),y real delay i[ind\
		]))* Euro good 1
	~	Euro/Goods
	~	unit labour costs
		
		## 05/04/23
		previous formula: 
		(ZIDZ((GWB i[ind]-level WTR gov paid i[ind])*(1+ss rate employer),y nom i[ind]))* \
		Euro good 1
		##
		That was a real variable (the wage share in each sector). Not a nominal to be \
		considered in the price formation.
		One possible solution is to multiply the numerator per the price level.
	|

gov share wage WTR=
	0.5
	~	
	~	share (%) of the wage increase covered by the government.
	|

wage WTR gov total cost=
	sum(level WTR gov paid i[ind!])
	~	
	~		|

level WTR gov paid gis[gender,ind,skill]= INTEG (
	delta wage WTR gov paid[gender,ind,skill],
		0*euro 1)
	~	
	~		|

delta wage WTR gov paid[gender,ind,skill]=
	delta wage WTR[gender,ind,skill]*gov share wage WTR
	~	
	~		|

in JG L gs[gender,skill]=
	IF THEN ELSE(Time <S Time Policy start,0* People 1 ,
	IF THEN ELSE(Time<Final time job guarantee,
	IF THEN ELSE(Time = S Time Policy start, Act Job Guarantee * max( 
	           (min(0.5*U number gs[gender,skill],JG maxL*share U number gs[gender,skill\
		]))
	           ,0*People 1),
	IF THEN ELSE(u>trigger JG:AND:e<0.9,Act Job Guarantee * max(0.15*U number gs[gender,\
		skill],0*People 1),0*People 1)
	
	),0*People 1))/ Year 1
	~	People/Year
	~	##
		
		there is a problem that a constant amount of people is gettin in the JG program. \
		this exceeds the quantity of 
		people available in the labor force.
		
		previous formula
		
		IF THEN ELSE(Time <S Time Policy start,0* People 1 ,
		IF THEN ELSE(Time < Final time job guarantee, Act Job Guarantee * max( 
		           min(0.5*U number gs[gender,skill],JG maxL*share U number gs[gender,skill])
		           ,0* People 1),0*People 1
		
		))/ Year 1
	|

RES public exp=
	IF THEN ELSE(Time<S Time Policy start,0*euro 1,Act RES public*(exog fund Enrg+exog fund Transport\
		+exog fund VAT))
	~	
	~		|

Active Social Policies=
	Act BI+Act cons red+Act Dividend Reduction+Act fin tax+Act focalized benefit+Act Job Guarantee\
		+Act labour tax redistribution+Act minimum wage+Act progressive Inc Tax+Act wealth tax\
		+Act WTR+Act WTR wage+Act maximum wage
	~	
	~		|

Active Environmental Policies=
	Act adapt+Act carbon tax+Act CT redistrib+Act elast beta+Act en eff+Act gradual adapt CT hh\
		+Act phase out+Act RES public
	~	
	~		|

tot Div=
	sum(Div i[ind!])
	~	
	~		|

RES shares g rates 2130 i[ind]=
	S1 RES shares g rates 2130 i[ind]*0.8+IF THEN ELSE(Time <S Time Policy start,0,Act RES public\
		*S1 RES shares g rates 2130 i[ind]*0.2)
	~	Dmnl
	~		|

Controle Problema LFPR=
	working age pop total-sum(Working age population cgs[cohorts!,gender!,skill!])
	~	
	~		|

teste2=
	sum(Pop 1524 g[gender!])+sum(Pop 2544 g[gender!])+sum(Pop 4564 g[gender!])+sum("Pop 65+ g"\
		[gender!])-sum(adult population s[skill!])
	~	
	~		|

teste1=
	sum(Skills 1524 gs[gender!,skill!])-sum(Pop 1524 g[gender!])
	~	
	~		|

delta wage WTR[gender,ind,skill]=
	IF THEN ELSE(
	Time <S Time Policy start,0*euro 1,
	Act WTR wage*wage delay gis[gender,ind,skill]*((delay hours i[ind]/hours i[ind])-1)
	)
	~	
	~		|

Act WTR wage=
	0
	~	Dmnl
	~	0 = INACTIVE
		1 = active
		
		This policy corrects the hourly earning in order to keep sustain the total \
		wage after reduction in hours of work.
	|

delay in JG L gs[gender,skill]= DELAY FIXED (
	in JG L gs[gender,skill], 1*Year 1,0)
	~	
	~		|

trigger JG=
	0.03
	~	
	~		|

delay hours i[ind]= DELAY FIXED (
	hours i[ind],1*Year 1, S1 hours i[ind])
	~	
	~		|

Controle Transf JG=
	sum(delay in JG gs[gender!,skill!])-sum(Transf JG[gender!,skill!])
	~	
	~		|

Transf JG[gender,low]=
	delay in JG gs[gender,low]*(1-low skill transformation JG
	[gender,mid]-low skill transformation JG[gender,hig]) ~~|
Transf JG[gender,mid]=
	(delay in JG gs[gender,mid]*mid skill transformation JG[gender
	,mid]+delay in JG gs[gender,low]*low skill transformation JG[gender
	,mid]) ~~|
Transf JG[gender,hig]=
	(delay in JG gs[gender,hig])+delay in JG gs[gender,low]*low skill transformation JG[\
		gender,hig]+delay in JG gs[gender,mid]*mid skill transformation JG[gender,hig]
	~	
	~	(sens JG unempl+(u gs[gender,low]-u delay gs[gender,low]))*(delay in JG \
		gs[gender,low]*low skill transformation JG[gender,low]+delay in JG \
		gs[gender,low]*low skill transformation JG
		[gender,mid]+delay in JG gs[gender,low]*low skill transformation \
		JG[gender,hig])
	|

JG L gs[gender,skill]= INTEG (
	Transf JG[gender,skill]-Out JG L gs[gender,skill],
		0* People 1)
	~	People
	~		|

Out JG L gs[gender, skill]=
	max((sens JG unempl+(u gs[gender,mid]-u delay gs[gender,mid]))*Transf JG[gender,skill\
		],0*People 1)
	~	People/Year
	~		|

low skill transformation JG[gender,low]=
	0.1 ~~|
low skill transformation JG[gender,mid]=
	0.6 ~~|
low skill transformation JG[gender,hig]=
	0.3
	~	Dmnl
	~		|

mid skill transformation JG[gender,low]=
	0 ~~|
mid skill transformation JG[gender,mid]=
	0.5 ~~|
mid skill transformation JG[gender,hig]=
	0.5
	~	
	~		|

delay in JG gs[gender,skill]= DELAY FIXED (
	in JG L gs[gender,skill],1*Year 1,0*People 1/Year 1)
	~	People/Year
	~		|

Act wealth tax=
	0
	~	Dmnl
	~	0: inactive
		1: active
		
		wealth tax aims to finance the Basic Income.
		when the wealth tax is active, the income tax created to BI is inactive.
	|

eq delay cap=
	DELAY FIXED(eq cap, Year 1, 0*euro 1)
	~	Euro
	~		|

wealth tax rate=
	IF THEN ELSE(Act wealth tax=1,BI exp/sum(tot W[assets!]),0)*ramp(0.33,11,13)+IF THEN ELSE\
		(Act WTR wage=1,(wage WTR gov total cost/sum(tot W[assets!])),0)+IF THEN ELSE(Act Job Guarantee\
		=1,(total cost JG/sum(tot W[assets!])),0)
	~	Dmnl
	~		|

in deposits gs[gender,skill]=
	savings gs[gender,skill]-in bonds gs[gender,skill]-(wealth tax rate*d delay gs[gender\
		,skill])
	~	Euro/Year
	~		|

LFPR delay gs[gender, skill]= DELAY FIXED (
	LFPR gs[gender,skill], Year 1, 0*People 1)
	~	
	~		|

in equity gs[gender,low]=
	0* euro 1/ Year 1 ~~|
in equity gs[gender,mid]=
	0* euro 1/ Year 1 ~~|
in equity gs[gender,hig]=
	sum(in Equity i[ind!])*(W gs[gender,hig,deposits]/(sum(W gs[gender!,hig,deposits])+W cap\
		[deposits]))/Year 1-wealth tax rate*eq delay gs[gender,hig]
	~	Euro/Year
	~		|

eq delay gs[gender,skill]= DELAY FIXED (
	eq gs[gender,skill], Year 1, 0*euro 1)
	~	Euro
	~		|

tot gov rev=
	soc sec rev + 
	inc tax rev + vat rev + 
	fin tax rev + corp tax rev + 
	Carbon tax tot + 
	wealth tax revenue
	~	Euro
	~	total government revenue
	|

b delay cap=
	DELAY FIXED(b cap, Year 1, 0*euro 1)
	~	Euro
	~		|

c19 LFPR 2020=
	-0.09
	~	Dmnl
	~	DATA FROM ILO, labor force participation rate 2020, 15-64y
		
		-0.0248
	|

c19 LFPR 2021=
	0.02
	~	Dmnl
	~	0,6%
		DATA FROM ILO, labor force participation rate 2021, 15-64y: 0.0061
	|

d delay cap= DELAY FIXED (
	d cap, Year 1, 0*euro 1)
	~	Euro
	~		|

d delay gs[gender,skill]= DELAY FIXED (
	d gs[gender,skill],Year 1, 0*euro 1)
	~	Euro
	~		|

b delay gs[gender, skill]= DELAY FIXED (
	b gs[gender,skill], Year 1, 0*euro 1)
	~	Euro
	~		|

wealth tax revenue=
	wealth tax rate*(sum(d delay gs[gender!,skill!])+sum(b delay gs[gender!,skill!])+sum\
		(eq delay gs[gender!,skill!])+d delay cap+b delay cap+eq delay cap)
	~	
	~		|

c19 LFPR 2022=
	0.03
	~	Dmnl
	~	Assuming complete recover of labor force participation rate to pre-pandemic level \
		2022, 15-64y: 
		0.0192
		
		1,92%
	|

per capita GDP real=
	GDP real/population total*People 1
	~	Euro constant
	~		|

gov c nom i[ind]= INTEG (
	IF THEN ELSE (def gdp > 0.015,max(0* euro 1,trend gov c i[ind]*convergence)/Year 1,max\
		(0* euro 1,trend gov c i[ind]*convergence)/Year 1+
	0.03*gov c nom delay i[ind]/Year 1),
		init gov c nom i[ind]*1.1)
	~	Euro
	~	government consumption nominal by industry (from national accounts)
	|

gov c nom delay i[ind]= DELAY FIXED (
	gov c nom i[ind] , 1* Year 1 , init gov c nom i[ind])
	~	Euro
	~		|

sens JG unempl=
	0.9
	~	Dmnl
	~	previously 
		0.2
		
		tested values as 0.6-0.7
	|

Palma ratio=
	smooth(ZIDZ( income SHARE top 10, income SHARE lowest 40),2)
	~	Dmnl
	~		|

wage ratio MAX to MIN=
	MAX wage all/MIN wage all
	~	Dmnl
	~		|

average daily labour income gs[gender,skill]=
	wage gs[gender,skill]*av daily work hours gs[gender,skill]/Hours 1
	~	Euro
	~		|

average daily labou income g[gender]=
	sum(average daily labour income gs[gender,skill!]*L gs[gender,skill!])/sum(L gs[gender\
		,skill!])
	~	Euro
	~		|

gender labour income gap ratio=
	average daily labou income g[female]/average daily labou income g[male]
	~	Dmnl
	~		|

Final time job guarantee=
	40
	~	Year
	~		|

wage dispersion s[skill]=
	MAX wage s[skill]/MIN wage s[skill]
	~	Dmnl
	~		|

MAX wage g[gender]=
	VMAX(MAX wage gs[gender,skill!])
	~	Euro
	~		|

MIN wage g[gender]=
	VMIN(MIN wage gs[gender,skill!])
	~	Euro
	~		|

MAX wage all=
	VMAX(wage gis[gender!,ind!,skill!])
	~	Euro
	~		|

MIN wage all=
	VMIN(wage gis[gender!,ind!,skill!])
	~	Euro
	~		|

MAX wage gs[gender,skill]=
	VMAX(wage gis[gender,ind!,skill])
	~	Euro
	~		|

MAX wage s[skill]=
	VMAX(MAX wage gs[gender!,skill])
	~	Euro
	~		|

MIN wage gs[gender,skill]=
	VMIN(wage gis[gender,ind!,skill])
	~	Euro
	~		|

wage dispersion gs[gender,skill]=
	MAX wage gs[gender,skill]/MIN wage gs[gender,skill]
	~	Dmnl
	~		|

MIN wage s[skill]=
	VMIN(MIN wage gs[gender!,skill])
	~	Euro
	~		|

income SHARE lowest 40=
	IF THEN ELSE(Sum pop share 40=10,yd share ordered gini[gini1]+yd share ordered gini[\
		gini2]+yd share ordered gini[gini3]+yd share ordered gini[gini4]+yd share ordered gini\
		[gini5]+yd share ordered gini[gini6]+yd share ordered gini[gini7]+yd share ordered gini\
		[gini8]+yd share ordered gini[gini9]+yd share ordered gini[gini10],
	IF THEN ELSE(Sum pop share 40=11,yd share ordered gini[gini1]+yd share ordered gini[\
		gini2]+yd share ordered gini[gini3]+yd share ordered gini[gini4]+yd share ordered gini\
		[gini5]+yd share ordered gini[gini6]+yd share ordered gini[gini7]+yd share ordered gini\
		[gini8]+yd share ordered gini[gini9]+yd share ordered gini[gini10]+yd share ordered gini\
		[gini11],
	IF THEN ELSE(Sum pop share 40=12,yd share ordered gini[gini1]+yd share ordered gini[\
		gini2]+yd share ordered gini[gini3]+yd share ordered gini[gini4]+yd share ordered gini\
		[gini5]+yd share ordered gini[gini6]+yd share ordered gini[gini7]+yd share ordered gini\
		[gini8]+yd share ordered gini[gini9]+yd share ordered gini[gini10]+yd share ordered gini\
		[gini11]+yd share ordered gini[gini12],
	IF THEN ELSE(Sum pop share 40=13,yd share ordered gini[gini1]+yd share ordered gini[\
		gini2]+yd share ordered gini[gini3]+yd share ordered gini[gini4]+yd share ordered gini\
		[gini5]+yd share ordered gini[gini6]+yd share ordered gini[gini7]+yd share ordered gini\
		[gini8]+yd share ordered gini[gini9]+yd share ordered gini[gini10]+yd share ordered gini\
		[gini11]+yd share ordered gini[gini12]+yd share ordered gini[gini13],
	IF THEN ELSE(Sum pop share 40=14,yd share ordered gini[gini1]+yd share ordered gini[\
		gini2]+yd share ordered gini[gini3]+yd share ordered gini[gini4]+yd share ordered gini\
		[gini5]+yd share ordered gini[gini6]+yd share ordered gini[gini7]+yd share ordered gini\
		[gini8]+yd share ordered gini[gini9]+yd share ordered gini[gini10]+yd share ordered gini\
		[gini11]+yd share ordered gini[gini12]+yd share ordered gini[gini14],
	IF THEN ELSE(Sum pop share 40=15,yd share ordered gini[gini1]+yd share ordered gini[\
		gini2]+yd share ordered gini[gini3]+yd share ordered gini[gini4]+yd share ordered gini\
		[gini5]+yd share ordered gini[gini6]+yd share ordered gini[gini7]+yd share ordered gini\
		[gini8]+yd share ordered gini[gini9]+yd share ordered gini[gini10]+yd share ordered gini\
		[gini11]+yd share ordered gini[gini12]+yd share ordered gini[gini14]+yd share ordered gini\
		[gini15],
	IF THEN ELSE(Sum pop share 40=16,yd share ordered gini[gini1]+yd share ordered gini[\
		gini2]+yd share ordered gini[gini3]+yd share ordered gini[gini4]+yd share ordered gini\
		[gini5]+yd share ordered gini[gini6]+yd share ordered gini[gini7]+yd share ordered gini\
		[gini8]+yd share ordered gini[gini9]+yd share ordered gini[gini10]+yd share ordered gini\
		[gini11]+yd share ordered gini[gini12]+yd share ordered gini[gini14]+yd share ordered gini\
		[gini15]+yd share ordered gini[gini16],
	IF THEN ELSE(Sum pop share 40=17,yd share ordered gini[gini1]+yd share ordered gini[\
		gini2]+yd share ordered gini[gini3]+yd share ordered gini[gini4]+yd share ordered gini\
		[gini5]+yd share ordered gini[gini6]+yd share ordered gini[gini7]+yd share ordered gini\
		[gini8]+yd share ordered gini[gini9]+yd share ordered gini[gini10]+yd share ordered gini\
		[gini11]+yd share ordered gini[gini12]+yd share ordered gini[gini14]+yd share ordered gini\
		[gini15]+yd share ordered gini[gini16]+yd share ordered gini[gini17],0
	))))))))
	~	Dmnl
	~		|

Sum pop share top 10=
	IF THEN ELSE(pop share ordered gini[gini25]+pop share ordered gini[gini24]>0.1, gini24\
		,
	
	IF THEN ELSE(pop share ordered gini[gini25]+pop share ordered gini[gini24]+pop share ordered gini\
		[gini23]>0.1, gini23,
	
	IF THEN ELSE(pop share ordered gini[gini25]+pop share ordered gini[gini24]+pop share ordered gini\
		[gini23]+pop share ordered gini[gini22]>0.1, gini22,
	
	IF THEN ELSE(pop share ordered gini[gini25]+pop share ordered gini[gini24]+pop share ordered gini\
		[gini23]+pop share ordered gini[gini22]+pop share ordered gini[gini21]>0.1, gini21,
	
	IF THEN ELSE(pop share ordered gini[gini25]+pop share ordered gini[gini24]+pop share ordered gini\
		[gini23]+pop share ordered gini[gini22]+pop share ordered gini[gini21]+pop share ordered gini\
		[gini20]>0.1, gini20,gini19
	
	)))))
	~	Dmnl
	~		|

income SHARE top 10=
	IF THEN ELSE(Sum pop share top 10=24,yd share ordered gini[gini25]+yd share ordered gini\
		[gini24],
	IF THEN ELSE(Sum pop share top 10=23,yd share ordered gini[gini25]+yd share ordered gini\
		[gini24]+yd share ordered gini[gini23],
	IF THEN ELSE(Sum pop share top 10=22,yd share ordered gini[gini25]+yd share ordered gini\
		[gini24]+yd share ordered gini[gini23]+yd share ordered gini[gini22],
	IF THEN ELSE(Sum pop share top 10=21,yd share ordered gini[gini25]+yd share ordered gini\
		[gini24]+yd share ordered gini[gini23]+yd share ordered gini[gini22]+yd share ordered gini\
		[gini21],
	IF THEN ELSE(Sum pop share top 10=20,yd share ordered gini[gini25]+yd share ordered gini\
		[gini24]+yd share ordered gini[gini23]+yd share ordered gini[gini22]+yd share ordered gini\
		[gini21]+yd share ordered gini[gini20],0
	)))))
	~	Dmnl
	~		|

Sum pop share 40=
	IF THEN ELSE(pop share ordered gini[gini1]+pop share ordered gini[gini2]+pop share ordered gini\
		[gini3]+pop share ordered gini[gini4]+pop share ordered gini[gini5]+pop share ordered gini\
		[gini6]+pop share ordered gini[gini7]+pop share ordered gini[gini8]+pop share ordered gini\
		[gini9]+pop share ordered gini[gini10]+pop share ordered gini[gini11]+pop share ordered gini\
		[gini12]+pop share ordered gini[gini13]+pop share ordered gini[gini14]+pop share ordered gini\
