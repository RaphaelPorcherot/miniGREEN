PT rand RCP45=
	RANDOM NORMAL(P min RCP45(Time), P max RCP45(Time) , P mean RCP45(Time) , P std RCP45\
		(Time) , seed )
	~	
	~	RPC4.5
		GET DIRECT LOOKUPS('environment.xlsx','damage','A','C2')
		[(0,0)-(40,10)],
		(0,12.2173),
		(1,13.1096),
		(2,12.9216),
		(3,12.6381),
		(4,13.366),
		(5,13.3155),
		(6,13.1301),
		(20,15.8074),
		(40,16.4755)
	|

Temperature=
	IF THEN ELSE(Time < S Time Policy start, 13.5,
	IF THEN ELSE(temp RCP scenario=0,13.5,
	IF THEN ELSE(temp RCP scenario=1,
	T rand RCP26 ,
	
	IF THEN ELSE(temp RCP scenario=2, 
	T rand RCP45,
	IF THEN ELSE(temp RCP scenario=3, 
	T rand RCP60, 
	
	T rand RCP85)
	))))
	~	Dmnl
	~	IF THEN ELSE(temp RCP scenario<=1, 
		T mean RCP26(Time) ,
		
		IF THEN ELSE(temp RCP scenario=2, 
		T rand RCP45(Time) ,
		
		IF THEN ELSE(temp RCP scenario=3, 
		T rand RCP60(Time), 
		
		T rand RCP85(Time))))
	|

