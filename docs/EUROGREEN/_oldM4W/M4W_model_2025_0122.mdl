	sum(corp tax i[ind!])
	~	Euro
	~		|

CPI=
	sum(p i[ind!]*price weights i[ind!])
	~	Euro/Euro constant
	~	consumer price index
	|

CPI delay= DELAY FIXED (
	CPI, Year 1 , initial cpi)
	~	Euro/Euro constant
	~		|

CT redistrib d[inc cat]=
	ZIDZ(
	Carbon tax tot*(eligible CT d[inc cat]*pop d[inc cat]),
	     sum(eligible CT d[inc cat!]*pop d[inc cat!])
	)
	~	Euro
	~		|

d cap= INTEG (
	in deposits cap,
		d0 cap)
	~	Euro [0,?]
	~	deposits held by capitalists
	|

d gs[gender,skill]= INTEG (
	in deposits gs[gender,skill],
		d0 s[skill]/2)
	~	Euro [0,?]
	~	deposits held by skill
	|

d0 cap=
	"w0\_cap"-b0 cap-eq0 cap
	~	Euro [0,?]
	~	initial deposits held by capitalists
	|

d0 s[low]=
	w0 s[low] ~~|
d0 s[mid]=
	w0 s[mid]-b0 s[mid] ~~|
d0 s[hig]=
	w0 s[hig]-b0 s[hig]-eq0 s[hig]
	~	Euro [0,?]
	~	initial deposits held by skill
	|

damage multiplier delay i[ind]= DELAY FIXED (
	damage multiplier i[ind], Year 1 , initial damage multiplier i[ind])
	~	Dmnl
	~		|

deaths 1524 gs[gender,skill]=
	deaths1524 g[gender]*(Skills 1524 gs[gender,skill]/Pop 1524 g[gender])
	~	People/Year
	~		|

deaths 2544 gs[gender,skill]=
	deaths2544 g[gender]*(Skills 2544 gs[gender,skill]/Pop 2544 g[gender])
	~	People/Year
	~		|

deaths 4564 gs[gender,skill]=
	deaths4564 g[gender]*(Skills 4564 gs[gender,skill]/Pop 4564 g[gender])
	~	People/Year
	~		|

"deaths 65+ gs"[gender,skill]=
	"deaths65+ g"[gender]*("Skills 65+ gs"[gender,skill]/"Pop 65+ g"[gender])
	~	People/Year
	~		|

deaths014 g[gender]=
	mortality rate cg[p0014,gender]*Pop 014 g[gender]/Year 1
	~	People/Year
	~		|

deaths1524 g[gender]=
	mortality rate cg[p1524,gender]*Pop 1524 g[gender]/Year 1
	~	People/Year
	~		|

deaths2544 g[gender]=
	mortality rate cg[p2544,gender]*Pop 2544 g[gender]/Year 1
	~	People/Year
	~		|

deaths4564 g[gender]=
	mortality rate cg[p4564,gender]*Pop 4564 g[gender]/Year 1
	~	People/Year
	~		|

"deaths65+ g"[gender]=
	(mortality rate cg[p65,gender]*"Pop 65+ g"[gender])/Year 1
	~	People/Year
	~		|

debt gdp=
	b/GDP nom
	~	percentage
	~		|

debt i[ind]= INTEG (
	in Loans i[ind]-out Loans i[ind]/Year 1,
		Loans initial i[ind])
	~	Euro
	~		|

debt repayment i[ind]=
	(debt i[ind]/lifetime K i[ind])*Year 1
	~	Euro
	~		|

def gdp=
	gov def/(GDP nom/Year 1)*100
	~	Dmnl
	~	perc
	|

delta total uw change empl=
	(in time use dt[inc low e f,unpaid w]*pop d[inc low e f] +
	in time use dt[inc low e m,unpaid w]*pop d[inc low e m] +
	in time use dt[inc mid e f,unpaid w]*pop d[inc mid e f] +
	in time use dt[inc mid e m,unpaid w]*pop d[inc mid e m] +
	in time use dt[inc hig e f,unpaid w]*pop d[inc hig e f] +
	in time use dt[inc hig e m,unpaid w]*pop d[inc hig e m])* Year 1/People 1
	~	Hours
	~		|

Delta UCC i[ind]=
	UCC delay i[ind]-UCC delay2 i[ind]
	~	Dmnl
	~		|

depreciation K delay i[ind]= DELAY FIXED (
	depreciation K i[ind], Year 1 , initial depreciation K i[ind])
	~	Euro constant/Year
	~		|

depreciation K i[ind]=
	K i[ind]*(depreciation rates i[ind])
	~	Euro constant/Year
	~		|

depreciation rates i[ind]=
	S1 depreciation rates i[ind]*IF THEN ELSE(Time<S Time Policy start,
	                Dmnl Year,
	                (1+min(S Time end-S Time Policy start,Time-S Time Policy start)*(S depreciation rates\
		/(S Time end-S Time Policy start)))
	                /Year 1)
	~	Dmnl/Year
	~		|

Div i[ind]=
	IF THEN ELSE(max investment switch =0:OR:1,  
	max(0* euro 1,Div rate*(profits post debt delay i[ind]-equity to liabilities ratio*I nom i\
		[ind])), 
	max(0* euro 1,Div rate*(profits post debt delay i[ind]-euro 1/ Euro constant 1 *equity to liabilities ratio\
		^2/(min(equity to liabilities ratio* euro 1/Euro constant 1,1* euro 1/Euro constant 1\
		-lev delay i[ind]))*I nom i[ind]))
	)
	~	Euro
	~	dividents paid
	|

Div rate=
	IF THEN ELSE(Act Dividend Reduction=1:AND:Time>S Time Policy start,1-percentage dividend reduction\
		,1)*0.3
	~	Dmnl
	~	fixed proportion of profits after investments distributed as dividends.
		calibrated: 24062021 - public, educ and health set to 0.
		 Div_rate[agri] = 0.0505971
		  Div_rate[mining] = 0.0719105
		  Div_rate[manufacturing] = 0.120411
		  Div_rate[petroleum] = 0.0834146
		  Div_rate[electricity] = 0.032472
		  Div_rate[water] = 0.261991
		  Div_rate[construction] = 0.0103556
		  Div_rate[trade] = 0.0992673
		  Div_rate[transport] = 0.167368
		  Div_rate[hospitality] = 0.191688
		  Div_rate[ict] = 0.245209
		  Div_rate[finance] = 0.199909
		  Div_rate[realestate] = 0.0265526
		  Div_rate[profserv] = 0.187114
		  Div_rate[public] = 0.278666
		  Div_rate[education] = 0.293568
		  Div_rate[health] = 0.0339958
		  Div_rate[entertainment] = 0.236237
		  Div_rate[otherserv] = 0.144203
	|

draw T2 i[ind]=
	IF THEN ELSE(random uniform(0,1,seed)>1-prob T2 i[ind], 1 , 0 )*((1-Switch Off Technology\
		)+(Switch Off Technology*Multiplier Innovation))
	~	Dmnl
	~		|

draw T3 i[ind]=
	IF THEN ELSE(random uniform(0,1,seed)>1-prob T3 i[ind], 1 , 0 )*((1-Switch Off Technology\
		)+(Switch Off Technology*Multiplier Innovation))
	~	Dmnl
	~		|

draw T4 i[ind]=
	IF THEN ELSE(random uniform(0,1,seed)>1-prob T4 i[ind], 1 , 0 )*((1-Switch Off Technology\
		)+(Switch Off Technology*Multiplier Innovation))
	~	Dmnl
	~		|

duration adapt=
	4
	~	Year
	~	31 --> adaptation slow
		4 --> adaptation fast
	|

e=
	sum(L gis[gender!,ind!,skill!])/sum(Working age population cgs[cohorts!,gender!,skill\
		!])
	~	percentage [?,1]
	~		|

E C hh nrg[nrg]=
	coef Ed to C fd hh nrg[nrg]*Ed fd hh nrg[nrg]
	~	kton
	~		|

E C nrg i[solid,ind]=
	coef Ed to C nrg i[solid,ind]*Ed Z nrg i[solid,ind] ~~|
E C nrg i[liquid,ind]=
	coef Ed to C nrg i[liquid,ind]*Ed Z nrg i[liquid,ind] ~~|
E C nrg i[gas,ind]=
	coef Ed to C nrg i[gas,ind]*Ed Z nrg i[gas,ind] ~~|
E C nrg i[biomass,ind]=
	coef Ed to C nrg i[biomass,ind]*Ed Z nrg i[biomass,ind] ~~|
E C nrg i[renew,ind]=
	0
	~	TJ
	~		|

E C Z i[ind]=
	sum(E C nrg i[nrg!,ind])
	~	TJ
	~		|

E C Ztot=
	sum(E C Z i[ind!])
	~	TJ
	~		|

e delay gs[gender,skill]= DELAY FIXED (
	e gs[gender,skill], Year 1 , e initial gs[gender,skill])
	~	Dmnl
	~		|

E exp i[ind]=
	Ecoef Exp i[ind]*total exp real i[ind]/(1e+06*Euro constant 1)* euro 1
	~	Euro
	~		|

E exp tot=
	sum(E exp i[ind!])
	~	Euro
	~		|

