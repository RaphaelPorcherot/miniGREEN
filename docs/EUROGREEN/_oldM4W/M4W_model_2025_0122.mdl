	|

mpc fct(
	[(0,0)-(1e+07,10)],(8196,1.1848),(16905,0.9195),(20038,0.8407),(24815,0.7592),(34111\
		,0.6545),(103500,0.4),(1e+06,0.2),(1e+07,0.1))
	~	Dmnl
	~	GET DIRECT LOOKUPS('economy.xlsx','consumption','24','B25')
	|

mpc inc d[inc cat]=
	max(0,
	    lookup extrapolate(mpc fct,(exp yd d[inc cat])/euro 1)*(
	                                                  (1+Euro constant 1/ euro 1*av infl cumulative d\
		[inc cat])^(1-lookup extrapolate(mpc fct,exp yd d[inc cat]/euro 1))
	                                                  )
	    )
	~	Dmnl [0,?]
	~	marginal propensity to consume out of income
		*((1+av_infl_cumulative_d[inc_cat])^(1-lookup_extrapolate(mpc_fct,exp_yd_d[\
		inc_cat]))))
	|

N olf gs[gender,skill]=
	max(50000* People 1,sum(Working age population cgs[cohorts!,gender,skill])-labour supply gs\
		[gender,skill])
	~	People
